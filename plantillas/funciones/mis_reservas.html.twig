{#
  «Mis reservas» del espectador, en /funcion/reservas (E4-04.1), como el wireframe
  mi-cuenta-mis-reservas: con la barra lateral de «Mi cuenta» (E4-10.13), el título con «Ir a la
  cartelera», la tabla con la función, la sala, la fecha, los lugares, el estado y las acciones de
  cada una, y el paginado numerado. Queda afuera lo que todavía no tiene datos: la tarjeta del
  usuario arriba de la barra (funciones no tiene la fecha de alta), las tarjetas de conducta,
  actividad y beneficios, las pestañas, los filtros y el pago.

  Variables:
  - reservas: lista de {id, codigo (8 caracteres; se muestra en dos grupos de 4), cantidad, total
    (ya escrito), estado ('pendiente_pago' | 'confirmada' | 'cancelada' | 'asistio' |
    'ausente'),
    estado_etiqueta, cancelable, calificable (si puede calificar la función: asistió, terminó y
    todavía no la calificó; EF-04.2), enlace_de_pago (a Mercado Pago, sólo en una pendiente que todavía
    está a tiempo; si no, null), funcion}. funcion es {id, titulo, url, fecha (o null), precio, sala, localidad}, o null si
    programación no la devolvió.
  - calificada: (bool) si se acaba de guardar una calificación, para el aviso.
  - sin_programacion: (bool) programación no respondió: ninguna fila tiene los datos de su función.
  - paginado: numero, total_paginas, total, anterior y siguiente (URL o null) y paginas: lista de
    {numero, url, actual}.
#}
{% extends 'cuenta.html.twig' %}

{% block titulo %}Mis reservas{% endblock %}
{% block seccion %}reservas{% endblock %}
{% block miga %}Mis reservas{% endblock %}

{% block panel %}
{# La pendiente de pago va con la píldora de contorno, sin modificador. #}
{% set clases_estado = { pendiente_pago: '', confirmada: 'estado-cuenta-activa', cancelada: 'estado-cuenta-cancelada', asistio: 'estado-cuenta-asistio', ausente: '' } %}
<div class="panel-reservas mis-reservas">
  <header class="encabezado-formulario-solicitud">
    <div class="solicitud-texto-cabecera">
      <h1 class="solicitud-titulo">Mis reservas</h1>
      <p class="solicitud-bajada">Todas tus reservas, su estado y lo que podés hacer con cada una.</p>
    </div>
    {% include 'parciales/boton.html.twig' with {
      texto: 'Ir a la cartelera',
      url: '/cartelera',
      variante: 'secundario'
    } only %}
  </header>

  {% if calificada|default(false) %}
    {% include 'parciales/mensaje.html.twig' with {
      tipo: 'exito',
      mensaje: '¡Gracias por calificar! Tu calificación ya cuenta para la sala y la película.'
    } only %}
  {% endif %}

  {% if sin_programacion|default(false) %}
    {% include 'parciales/mensaje.html.twig' with {
      tipo: 'advertencia',
      mensaje: 'Ahora no podemos mostrar los datos de las funciones. Tus reservas y sus códigos siguen siendo válidos.'
    } only %}
  {% endif %}

  {% if reservas is empty %}
    {% include 'parciales/mensaje.html.twig' with {
      tipo: 'info',
      mensaje: 'Todavía no reservaste lugares. En la cartelera están las próximas funciones.'
    } only %}
  {% else %}
    <p class="sr-only" role="status">{{ paginado.total }} {{ paginado.total == 1 ? 'reserva' : 'reservas' }}</p>
    <div class="tabla-admin-contenedor" tabindex="0" role="region" aria-label="Mis reservas">
      <table class="tabla-admin">
        <thead>
          <tr>
            <th scope="col">Función</th>
            <th scope="col">Sala</th>
            <th scope="col">Fecha</th>
            <th scope="col">Lugares</th>
            <th scope="col">Código</th>
            <th scope="col">Estado</th>
            <th scope="col">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {% for reserva in reservas %}
            <tr data-reserva="{{ reserva.id }}">
              {% if reserva.funcion %}
                <td><a href="{{ reserva.funcion.url }}" class="tabla-admin-principal">{{ reserva.funcion.titulo }}</a></td>
                <td>{{ reserva.funcion.sala }} <span class="tabla-admin-secundario">{{ reserva.funcion.localidad }}</span></td>
                <td>{{ reserva.funcion.fecha ?? 'A confirmar' }}</td>
              {% elseif sin_programacion|default(false) %}
                <td colspan="3"><span class="tabla-admin-secundario">—</span></td>
              {% else %}
                <td colspan="3"><span class="tabla-admin-secundario">Ya no está en la cartelera</span></td>
              {% endif %}
              <td>{{ reserva.cantidad }}</td>
              <td><span class="panel-reservas-codigo">{{ reserva.codigo|slice(0, 4) }}-{{ reserva.codigo|slice(4) }}</span></td>
              <td><span class="estado-cuenta {{ clases_estado[reserva.estado] ?? '' }}">{{ reserva.estado_etiqueta }}</span></td>
              <td>
                <div class="mis-reservas-acciones">
                  {% if reserva.enlace_de_pago|default(null) %}
                    {% include 'parciales/boton.html.twig' with {
                      texto: 'Pagar',
                      url: reserva.enlace_de_pago,
                      tamano: 'chico',
                      aria_label: 'Pagar la reserva ' ~ reserva.codigo ~ ' con Mercado Pago'
                    } only %}
                  {% endif %}
                  {% include 'parciales/boton.html.twig' with {
                    texto: 'Ver comprobante',
                    url: '/funcion/reservas/' ~ reserva.id,
                    variante: 'secundario',
                    tamano: 'chico',
                    aria_label: 'Ver el comprobante de la reserva ' ~ reserva.codigo
                  } only %}
                  {% if reserva.calificable|default(false) %}
                    {% include 'parciales/boton.html.twig' with {
                      texto: 'Calificar función',
                      url: '/funcion/reservas/' ~ reserva.id ~ '/calificar',
                      tamano: 'chico',
                      aria_label: 'Calificar la función de la reserva ' ~ reserva.codigo
                    } only %}
                  {% endif %}
                  {% if reserva.cancelable %}
                    {% include 'parciales/boton.html.twig' with {
                      texto: 'Cancelar',
                      url: '/funcion/reservas/' ~ reserva.id ~ '/cancelar',
                      variante: 'fantasma',
                      tamano: 'chico',
                      aria_label: 'Cancelar la reserva ' ~ reserva.codigo
                    } only %}
                  {% endif %}
                </div>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% if paginado.total_paginas > 1 %}
      <nav class="paginado-numerado" aria-label="Páginas de mis reservas">
        <ul>
          {% for pagina in paginado.paginas %}
            {% if pagina.actual %}
              <li><a href="{{ pagina.url }}" class="paginado-numero actual" aria-current="page">{{ pagina.numero }}</a></li>
            {% else %}
              <li><a href="{{ pagina.url }}" class="paginado-numero"{% if pagina.url == paginado.anterior %} rel="prev"{% elseif pagina.url == paginado.siguiente %} rel="next"{% endif %} aria-label="Página {{ pagina.numero }}">{{ pagina.numero }}</a></li>
            {% endif %}
          {% endfor %}
        </ul>
      </nav>
    {% endif %}
  {% endif %}
</div>
{% endblock %}
