{#
  Usuarios y roles del administrador, en /cuenta/administracion/usuarios: todas las cuentas, con
  un buscador por nombre o correo. Como el wireframe de la E2 (administracion-usuarios), sin las
  estadísticas ni los parámetros, que no son de esta entrega. El buscador es un formulario GET, así
  viaja en la URL y funciona sin JavaScript.

  Variables:
  - usuarios: lista de {id, nombre, correo, roles (lista de valores de Rol, de menor a mayor), estado (pendiente, activa o suspendida), alta (dd/mm/aaaa)}.
  - busqueda: el texto que se buscó en el nombre y el correo, o null si no se busca nada.
  - avisos: lista de textos, uno si la búsqueda no era válida y se dejó afuera.
  - paginado: numero, total_paginas, total_usuarios, y las URL anterior y siguiente (null si no hay).
#}
{% extends 'base.html.twig' %}

{% block titulo %}Usuarios y roles{% endblock %}

{% block contenido %}
<div class="contenedor">
  <nav class="navegacion-migas" aria-label="Migas de pan">
    <ol class="lista-migas">
      <li class="item-miga"><a href="/" class="enlace-miga">Inicio</a></li>
      <li class="separador-miga" aria-hidden="true">/</li>
      <li class="item-miga">Administración</li>
      <li class="separador-miga" aria-hidden="true">/</li>
      <li class="item-miga miga-activa" aria-current="page">Usuarios y roles</li>
    </ol>
  </nav>

  <header class="encabezado-formulario-solicitud">
    <div class="solicitud-texto-cabecera">
      <h1 class="solicitud-titulo">Usuarios y roles</h1>
      <p class="solicitud-bajada">Buscá una cuenta por su nombre o su correo.</p>
    </div>
  </header>

  <form class="filtros-cartelera buscador-salas" action="/cuenta/administracion/usuarios" method="get" role="search" aria-label="Buscar usuarios">
    {% include 'parciales/campo.html.twig' with {
      nombre: 'q',
      etiqueta: 'Buscar',
      tipo: 'search',
      valor: busqueda ?? '',
      placeholder: 'Nombre o correo'
    } only %}
    <div class="filtros-cartelera-acciones">
      {% include 'parciales/boton.html.twig' with { texto: 'Buscar', variante: 'primario' } only %}
      {% if busqueda is not null %}
        {% include 'parciales/boton.html.twig' with { texto: 'Limpiar', url: '/cuenta/administracion/usuarios', variante: 'fantasma' } only %}
      {% endif %}
    </div>
  </form>

  {% if avisos is not empty %}
    {% include 'parciales/mensaje.html.twig' with {
      tipo: 'advertencia',
      titulo: 'La búsqueda no se aplicó',
      detalles: avisos
    } only %}
  {% endif %}

  {% if usuarios is empty %}
    {% include 'parciales/mensaje.html.twig' with {
      tipo: 'info',
      mensaje: busqueda is not null
        ? 'No hay usuarios que coincidan con la búsqueda. Probá con otro nombre o correo.'
        : 'Todavía no hay usuarios registrados.'
    } only %}
  {% else %}
    <div class="cartelera-resumen">
      <p class="cartelera-resultados" role="status">
        {{ paginado.total_usuarios }} {{ paginado.total_usuarios == 1 ? 'usuario' : 'usuarios' }}
      </p>
    </div>

    {# La tabla se desplaza dentro de su caja en pantallas angostas: la página no se corre de costado. #}
    <div class="tabla-admin-contenedor" tabindex="0" role="region" aria-label="Usuarios">
      <table class="tabla-admin">
        <thead>
          <tr>
            <th scope="col">Usuario</th>
            <th scope="col">Roles</th>
            <th scope="col">Estado</th>
            <th scope="col">Alta</th>
          </tr>
        </thead>
        <tbody>
          {% for usuario in usuarios %}
            <tr data-usuario="{{ usuario.id }}">
              <td>
                <span class="tabla-admin-principal">{{ usuario.nombre }}</span>
                <span class="tabla-admin-secundario">{{ usuario.correo }}</span>
              </td>
              <td>
                <ul class="tabla-admin-insignias">
                  {% for rol in usuario.roles %}
                    <li class="usuario-rol rol-{{ rol }}">{{ rol }}</li>
                  {% endfor %}
                </ul>
              </td>
              <td><span class="estado-cuenta estado-cuenta-{{ usuario.estado }}">{{ usuario.estado }}</span></td>
              <td>{{ usuario.alta }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

    {% if paginado.total_paginas > 1 %}
      <nav class="paginado" aria-label="Páginas de usuarios">
        {% if paginado.anterior %}
          <a href="{{ paginado.anterior }}" class="boton boton-secundario boton-chico" rel="prev">Anterior</a>
        {% endif %}
        <span class="paginado-actual" aria-current="page">Página {{ paginado.numero }} de {{ paginado.total_paginas }}</span>
        {% if paginado.siguiente %}
          <a href="{{ paginado.siguiente }}" class="boton boton-secundario boton-chico" rel="next">Siguiente</a>
        {% endif %}
      </nav>
    {% endif %}
  {% endif %}
</div>
{% endblock %}
