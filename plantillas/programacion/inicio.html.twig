{#
  Portada, en /: para cualquiera, con o sin sesión. Un buscador que lleva a la cartelera filtrada
  (un formulario GET, así funciona sin JavaScript), el carrusel de destacadas, las próximas
  funciones y algunas salas, cada sección con el acceso a su listado completo.

  El carrusel (E4-07) es una lista: el componente Carrusel (estaticos/js/componentes/carrusel.js)
  la convierte en diapositivas. Sin JavaScript queda como una tira que se desplaza de costado, así
  ninguna destacada queda escondida. El wireframe «Home» no dibuja un destacado: va en una franja
  propia, antes de las próximas funciones, para no mover nada de lo que ya estaba.

  Encabezados, sin saltar niveles: h1 la portada; h2 cada sección; h3 cada tarjeta.

  Variables:
  - destacadas: (opcional) las próximas funciones que tienen afiche, con los mismos datos que las
    tarjetas (id, titulo, afiche, estado, precio, sala, localidad, fecha). Sin ninguna, no hay
    carrusel.
  - funciones: lista de las próximas funciones de la cartelera, como las recibe
    parciales/tarjeta_funcion.html.twig.
  - total_funciones: (int) cuántas funciones hay en toda la cartelera.
  - salas: lista de salas publicadas, como las recibe parciales/tarjeta_sala.html.twig.
  - total_salas: (int) cuántas salas publicadas hay.
  - localidades: lista de nombres de localidad con funciones, para el buscador.
#}
{% extends 'base.html.twig' %}

{% block titulo %}Cine independiente en salas de tu zona{% endblock %}

{% block contenido %}
{% set opciones_localidad = [{valor: '', etiqueta: 'Todas'}] %}
{% for localidad in localidades %}
  {% set opciones_localidad = opciones_localidad|merge([{valor: localidad, etiqueta: localidad}]) %}
{% endfor %}

<section class="portada-presentacion">
  <div class="contenedor">
    <p class="portada-antetitulo">Cine independiente · Salas indie · Programación participativa</p>
    <h1 class="portada-titulo">El cine que no llega a la cartelera, programado por quienes lo van a ver</h1>
    <p class="portada-bajada">Votá qué se proyecta, acordá la fecha con el resto del público y reservá tu lugar en salas independientes de tu zona.</p>

    <form class="portada-buscador" action="/cartelera" method="get" role="search" aria-label="Buscar funciones">
      {% include 'parciales/campo.html.twig' with {
        nombre: 'q',
        etiqueta: 'Qué querés ver',
        tipo: 'search',
        valor: '',
        placeholder: 'Película, director o sala'
      } only %}
      {% include 'parciales/campo.html.twig' with {
        nombre: 'localidad',
        etiqueta: 'Dónde',
        tipo: 'select',
        valor: '',
        opciones: opciones_localidad
      } only %}
      <div class="portada-buscador-accion">
        {% include 'parciales/boton.html.twig' with { texto: 'Buscar funciones', variante: 'primario' } only %}
      </div>
    </form>

    <p class="portada-resumen">
      <span><span aria-hidden="true">📍</span> {{ total_salas }} {{ total_salas == 1 ? 'sala publicada' : 'salas publicadas' }}</span>
      <span><span aria-hidden="true">📅</span> {{ total_funciones }} {{ total_funciones == 1 ? 'función' : 'funciones' }} en cartelera</span>
    </p>
  </div>
</section>

<div class="contenedor">
  {% if destacadas|default([]) is not empty %}
    <section class="portada-seccion" aria-labelledby="portada-destacadas-titulo">
      <header class="portada-seccion-cabecera">
        <h2 id="portada-destacadas-titulo" class="portada-seccion-titulo">Destacadas</h2>
      </header>
      <div class="carrusel" data-carrusel aria-label="Funciones destacadas">
        <ul class="carrusel-pista">
          {% for funcion in destacadas %}
            {% set url_funcion = '/cartelera/' ~ funcion.id %}
            <li class="carrusel-diapositiva">
              {# El mismo afiche, desenfocado, de fondo: el afiche se ve entero y esto llena el resto #}
              <img src="{{ funcion.afiche }}" alt="" class="carrusel-fondo">
              <img src="{{ funcion.afiche }}" alt="Afiche de {{ funcion.titulo }}" class="carrusel-imagen">
              <div class="carrusel-texto">
                {% if funcion.estado == 'EN_VOTACION_TITULOS' %}
                  <span class="insignia-estado insignia-votacion">En votación de títulos</span>
                {% elseif funcion.estado == 'EN_ACUERDO_FECHA' %}
                  <span class="insignia-estado insignia-acuerdo">En acuerdo de fecha</span>
                {% else %}
                  <span class="insignia-estado insignia-programada">Programada</span>
                {% endif %}
                <h3 class="carrusel-titulo"><a href="{{ url_funcion }}" class="carrusel-titulo-enlace">{{ funcion.titulo }}</a></h3>
                <p class="carrusel-dato">
                  {% include 'parciales/icono.html.twig' with { nombre: 'ubicacion', clase: 'meta-icono' } only %}
                  <span>{{ funcion.sala ?? 'Sala a confirmar' }}{% if funcion.localidad|default(null) %} · {{ funcion.localidad }}{% endif %}</span>
                </p>
                <p class="carrusel-dato">
                  {% include 'parciales/icono.html.twig' with { nombre: 'calendario', clase: 'meta-icono' } only %}
                  <span>{{ funcion.fecha ?? 'Fecha a definir' }} · {{ funcion.precio ?? 'A la gorra' }}</span>
                </p>
                {% include 'parciales/boton.html.twig' with {
                  texto: funcion.estado == 'PROGRAMADA' ? 'Ver función' : 'Votar',
                  url: url_funcion,
                  variante: 'primario',
                  clase: 'carrusel-accion',
                  aria_label: (funcion.estado == 'PROGRAMADA' ? 'Ver función ' : 'Votar en ') ~ funcion.titulo
                } only %}
              </div>
            </li>
          {% endfor %}
        </ul>
      </div>
    </section>
  {% endif %}

  <section class="portada-seccion" aria-labelledby="portada-funciones-titulo">
    <header class="portada-seccion-cabecera">
      <h2 id="portada-funciones-titulo" class="portada-seccion-titulo">Próximas funciones</h2>
      <a href="/cartelera" class="portada-seccion-enlace">Ver la cartelera completa</a>
    </header>
    {% if funciones is empty %}
      {% include 'parciales/mensaje.html.twig' with {
        tipo: 'info',
        mensaje: 'Todavía no hay funciones programadas.'
      } only %}
    {% else %}
      <div class="cuadricula-funciones portada-funciones">
        {% for funcion in funciones %}
          {% include 'parciales/tarjeta_funcion.html.twig' with { funcion: funcion } only %}
        {% endfor %}
      </div>
    {% endif %}
  </section>

  <section class="portada-seccion" aria-labelledby="portada-salas-titulo">
    <header class="portada-seccion-cabecera">
      <h2 id="portada-salas-titulo" class="portada-seccion-titulo">Salas indie</h2>
      <a href="/salas" class="portada-seccion-enlace">Ver todas las salas</a>
    </header>
    {% if salas is empty %}
      {% include 'parciales/mensaje.html.twig' with {
        tipo: 'info',
        mensaje: 'Todavía no hay salas publicadas.'
      } only %}
    {% else %}
      <div class="portada-salas">
        {% for sala in salas %}
          {% include 'parciales/tarjeta_sala.html.twig' with { sala: sala, compacta: true } only %}
        {% endfor %}
      </div>
    {% endif %}
  </section>
</div>
{% endblock %}
