{#
  «Mis funciones» del organizador, en /organizador/funciones: las de sus salas, en cualquier
  estado, con la fecha si ya la tienen. Es la pantalla desde la que las sigue mientras recorren su
  ciclo de vida (votación de títulos, acuerdo de fecha, programada, cancelada o finalizada).

  Usa la tabla del panel del administrador (tabla-admin), como «Salas»: es la misma forma de
  listar con estado, y así las pantallas de listado se ven igual en todo el sitio. El alta, la
  edición y la cancelación suman su columna de acciones cuando tengan pantalla (IC-121 a IC-123).

  Variables:
  - funciones: lista de funciones con id, titulo, titulos_elegidos, sala, sala_id,
    sala_habilitada, estado, estado_valor, es_final, fecha (o null), precio y cupo.
#}
{% extends 'base.html.twig' %}

{% block titulo %}Mis funciones{% endblock %}

{% block contenido %}
<div class="contenedor">
  <nav class="navegacion-migas" aria-label="Migas de pan">
    <ol class="lista-migas">
      <li class="item-miga"><a href="/" class="enlace-miga">Inicio</a></li>
      <li class="separador-miga" aria-hidden="true">/</li>
      <li class="item-miga miga-activa" aria-current="page">Mis funciones</li>
    </ol>
  </nav>

  <header class="encabezado-formulario-solicitud">
    <div class="solicitud-texto-cabecera">
      <h1 class="solicitud-titulo">Mis funciones</h1>
      <p class="solicitud-bajada">Las funciones de tus salas. Una función aparece en la cartelera cuando queda programada y su sala está habilitada.</p>
    </div>
  </header>

  {% if funciones is empty %}
    {% include 'parciales/mensaje.html.twig' with {
      tipo: 'info',
      mensaje: 'Todavía no tenés ninguna función en tus salas.'
    } only %}
  {% else %}
    {# La tabla se desplaza dentro de su caja en pantallas angostas: la página no se corre de costado. #}
    <div class="tabla-admin-contenedor" tabindex="0" role="region" aria-label="Mis funciones">
      <table class="tabla-admin">
        <thead>
          <tr>
            <th scope="col">Función</th>
            <th scope="col">Sala</th>
            <th scope="col">Fecha</th>
            <th scope="col">Estado</th>
            <th scope="col">Entrada</th>
          </tr>
        </thead>
        <tbody>
          {% for funcion in funciones %}
            <tr data-funcion="{{ funcion.id }}">
              <td>
                {# Sólo lleva a la ficha la función de una sala habilitada: hasta que la habiliten, no hay ficha que mostrar. #}
                {% if funcion.sala_habilitada %}
                  <a href="/cartelera/{{ funcion.id }}" class="tabla-admin-principal">{{ funcion.titulo }}</a>
                {% else %}
                  <span class="tabla-admin-principal">{{ funcion.titulo }}</span>
                {% endif %}
                {# Mientras se votan los títulos, lo que se lista son las candidatas y no lo que se proyecta. #}
                {% if not funcion.titulos_elegidos %}
                  <span class="tabla-admin-secundario">títulos candidatos</span>
                {% endif %}
              </td>
              <td>
                {% if funcion.sala_habilitada %}
                  <a href="/salas/{{ funcion.sala_id }}" class="tabla-admin-principal">{{ funcion.sala }}</a>
                {% else %}
                  <span class="tabla-admin-principal">{{ funcion.sala }}</span>
                  <span class="tabla-admin-secundario">esperando habilitación</span>
                {% endif %}
              </td>
              <td>{{ funcion.fecha ?? 'Sin fecha todavía' }}</td>
              <td>
                {% if funcion.estado_valor == 'programada' %}
                  <span class="estado-cuenta estado-cuenta-activa">{{ funcion.estado }}</span>
                {% elseif funcion.estado_valor == 'cancelada' %}
                  <span class="estado-cuenta estado-cuenta-cancelada">{{ funcion.estado }}</span>
                {% else %}
                  <span class="estado-cuenta">{{ funcion.estado }}</span>
                {% endif %}
              </td>
              <td>
                <span class="tabla-admin-principal">{{ funcion.precio }}</span>
                <span class="tabla-admin-secundario">{{ funcion.cupo }} lugares</span>
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}
</div>
{% endblock %}
