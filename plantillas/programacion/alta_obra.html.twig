{#
  Formulario de alta y edición de obra / película (E4-08.1 - Wireframe «mi-cuenta-alta-obra»).
  Permite al organizador registrar y editar obras de cine independiente para programar funciones.

  Variables:
  - es_edicion: (bool, por defecto false)
  - accion: (string, por defecto '/organizador/obras/nueva')
  - valores: (array) datos cargados previamente
  - errores: (array) mensajes de validación por campo
  - reglas: (array) reglas de validación del backend para sincronización
  - error_general: (?string) error global si falló la operación
  - mensaje_exito: (?string) confirmación exitosa
  - generos: lista de géneros disponibles en el catálogo (id, nombre)
  - tipos_obra: lista de tipos [{valor: 'pelicula', etiqueta: 'Película'}, ...]
  - origenes_copia: lista de orígenes [{valor: 'obra_propia', etiqueta: 'Obra propia'}, ...]
  - afiche_actual: (?string) URL de la imagen de afiche cargada actualmente si es edición
  - csrf: token de protección contra ataques CSRF
#}
{% extends 'base.html.twig' %}

{% block titulo %}{{ es_edicion|default(false) ? 'Editar obra' : 'Nueva obra' }}{% endblock %}

{% block contenido %}
<div class="contenedor-formulario-amplio">
  {# Migas de pan #}
  <nav class="navegacion-migas" aria-label="Migas de pan">
    <ol class="lista-migas">
      <li class="item-miga"><a href="/" class="enlace-miga">Inicio</a></li>
      <li class="separador-miga" aria-hidden="true">/</li>
      <li class="item-miga"><a href="/organizador/obras" class="enlace-miga">Mis obras</a></li>
      <li class="separador-miga" aria-hidden="true">/</li>
      <li class="item-miga miga-activa" aria-current="page">{{ es_edicion|default(false) ? 'Editar obra' : 'Nueva obra' }}</li>
    </ol>
  </nav>

  {# Encabezado #}
  <header class="encabezado-formulario-solicitud">
    <div class="solicitud-texto-cabecera">
      <h1 class="solicitud-titulo">{{ es_edicion|default(false) ? 'Editar obra' : 'Cargar obra al catálogo' }}</h1>
      <p class="solicitud-bajada">
        Registrá una película o cortometraje para poder seleccionarla al proponer funciones en las salas de la comunidad.
      </p>
    </div>
  </header>

  {# Alerta de error general #}
  {% if error_general is defined and error_general %}
    {% include 'parciales/mensaje.html.twig' with {
      tipo: 'error',
      titulo: 'No se pudo guardar la obra',
      mensaje: error_general
    } only %}
  {% endif %}

  {# Alerta de éxito #}
  {% if mensaje_exito is defined and mensaje_exito %}
    {% include 'parciales/mensaje.html.twig' with {
      tipo: 'exito',
      titulo: '¡Obra guardada!',
      mensaje: mensaje_exito
    } only %}
  {% endif %}

  {% set opciones_tipo = tipos_obra ?? [
    { valor: 'pelicula', etiqueta: 'Película' },
    { valor: 'cortometraje', etiqueta: 'Cortometraje' }
  ] %}

  {% set opciones_origen = origenes_copia ?? [
    { valor: 'obra_propia', etiqueta: 'Obra propia' },
    { valor: 'dominio_publico', etiqueta: 'Dominio público' },
    { valor: 'licencia_adquirida', etiqueta: 'Licencia adquirida' }
  ] %}

  <form action="{{ accion|default('/organizador/obras/nueva') }}" method="POST" enctype="multipart/form-data" class="formulario-sala formulario-alta-obra" data-validar-en-linea>
    <input type="hidden" name="_csrf" value="{{ csrf }}">

    {# ==================================================================== #}
    {# SECCIÓN 1: DATOS PRINCIPALES DE LA OBRA                              #}
    {# ==================================================================== #}
    <fieldset class="seccion-formulario">
      <legend class="seccion-leyenda">
        <span class="seccion-titulo">Ficha técnica</span>
        <span class="seccion-subtitulo">Título, dirección, año y duración para identificar la obra.</span>
      </legend>

      {# Título #}
      {% include 'parciales/campo.html.twig' with (reglas.titulo ?? {})|merge({
        nombre: 'titulo',
        etiqueta: 'Título de la obra',
        tipo: 'text',
        valor: valores.titulo ?? '',
        placeholder: 'Ej: Historias extraordinarias',
        maximo: 150,
        requerido: true,
        error: errores.titulo ?? null
      }) only %}

      {# Director #}
      {% include 'parciales/campo.html.twig' with (reglas.director ?? {})|merge({
        nombre: 'director',
        etiqueta: 'Dirección / Realización',
        tipo: 'text',
        valor: valores.director ?? '',
        placeholder: 'Ej: Mariano Llinás',
        maximo: 100,
        requerido: true,
        error: errores.director ?? null
      }) only %}

      <div class="fila-campos-doble">
        {# Año #}
        {% include 'parciales/campo.html.twig' with (reglas.anio ?? {})|merge({
          nombre: 'anio',
          etiqueta: 'Año de estreno',
          tipo: 'number',
          valor: valores.anio ?? '',
          valor_minimo: 1888,
          placeholder: 'Ej: 2008',
          requerido: true,
          error: errores.anio ?? null
        }) only %}

        {# Duración en minutos #}
        {% include 'parciales/campo.html.twig' with (reglas.duracion ?? (reglas.duracion_minutos ?? {}))|merge({
          nombre: 'duracion',
          etiqueta: 'Duración (minutos)',
          tipo: 'number',
          valor: valores.duracion ?? (valores.duracion_minutos ?? ''),
          valor_minimo: 1,
          placeholder: 'Ej: 90',
          requerido: true,
          error: errores.duracion ?? (errores.duracion_minutos ?? null)
        }) only %}
      </div>

      <div class="fila-campos-doble">
        {# Tipo de producción #}
        {% include 'parciales/campo.html.twig' with (reglas.tipo ?? {})|merge({
          nombre: 'tipo',
          etiqueta: 'Tipo de producción',
          tipo: 'select',
          valor: valores.tipo ?? 'pelicula',
          opciones: opciones_tipo,
          requerido: true,
          error: errores.tipo ?? null
        }) only %}

        {# Origen de la copia / Derechos #}
        {% include 'parciales/campo.html.twig' with (reglas.origen_copia ?? {})|merge({
          nombre: 'origen_copia',
          etiqueta: 'Derechos de exhibición / Copia',
          tipo: 'select',
          valor: valores.origen_copia ?? 'obra_propia',
          opciones: opciones_origen,
          ayuda: 'Condición legal de la copia para proyectarla en salas comunitarias.',
          requerido: true,
          error: errores.origen_copia ?? null
        }) only %}
      </div>
    </fieldset>

    {# ==================================================================== #}
    {# SECCIÓN 2: GÉNEROS Y SINOPSIS                                        #}
    {# ==================================================================== #}
    <fieldset class="seccion-formulario">
      <legend class="seccion-leyenda">
        <span class="seccion-titulo">Propuesta artística</span>
        <span class="seccion-subtitulo">Géneros cinematográficos y descripción argumental.</span>
      </legend>

      {# Selección múltiple de géneros mediante checkboxes accesibles #}
      {% set error_generos = errores.generos ?? null %}
      <div class="grupo-campo grupo-campo-generos{% if error_generos %} con-error{% endif %}">
        <fieldset class="generos-fieldset">
          <legend class="campo-etiqueta generos-leyenda">
            Géneros cinematográficos
            <span class="campo-requerido" aria-hidden="true" title="Campo obligatorio">*</span>
          </legend>
          <p class="campo-ayuda">Seleccioná uno o más géneros que describan la propuesta artística.</p>

          <div class="campo-generos-cuadricula" role="group" aria-label="Géneros de la obra">
            {% if generos is defined and generos is not empty %}
              {% for gen in generos %}
                {% set gen_id = gen.id ?? gen %}
                {% set gen_nombre = gen.nombre ?? gen %}
                {% set seleccionado = false %}
                {% if valores.generos is defined %}
                  {% if valores.generos is iterable %}
                    {% for g in valores.generos %}
                      {% if g == gen_id or g == gen_nombre %}
                        {% set seleccionado = true %}
                      {% endif %}
                    {% endfor %}
                  {% else %}
                    {% if valores.generos == gen_id or valores.generos == gen_nombre %}
                      {% set seleccionado = true %}
                    {% endif %}
                  {% endif %}
                {% endif %}
                <label class="campo-checkbox-etiqueta genero-opcion-item">
                  <input
                    type="checkbox"
                    name="generos[]"
                    value="{{ gen_id }}"
                    class="campo-control-checkbox"
                    {% if seleccionado %}checked{% endif %}
                    {% if error_generos %}aria-invalid="true" aria-describedby="error-generos"{% endif %}
                  >
                  <span class="checkbox-texto">{{ gen_nombre }}</span>
                </label>
              {% endfor %}
            {% else %}
              <p class="campo-ayuda">No hay géneros cargados en el sistema.</p>
            {% endif %}
          </div>
        </fieldset>

        {% if error_generos %}
          <span id="error-generos" class="campo-error" role="alert">
            <span class="error-icono" aria-hidden="true">⚠️</span>
            {{ error_generos }}
          </span>
        {% endif %}
      </div>

      {# Sinopsis #}
      {% include 'parciales/campo.html.twig' with (reglas.sinopsis ?? {})|merge({
        nombre: 'sinopsis',
        etiqueta: 'Sinopsis argumental',
        tipo: 'textarea',
        filas: 5,
        valor: valores.sinopsis ?? '',
        placeholder: 'Resumen o síntesis argumental de la obra para el público de la cartelera...',
        maximo: 2000,
        ayuda: 'Hasta 2000 caracteres describiendo la trama o propuesta.',
        requerido: true,
        error: errores.sinopsis ?? null
      }) only %}
    </fieldset>

    {# ==================================================================== #}
    {# SECCIÓN 3: AFICHE DE LA OBRA                                         #}
    {# ==================================================================== #}
    <fieldset class="seccion-formulario">
      <legend class="seccion-leyenda">
        <span class="seccion-titulo">Afiche de la obra</span>
        <span class="seccion-subtitulo">Imagen promocional para la cartelera y fichas de función.</span>
      </legend>

      {% if afiche_actual is defined and afiche_actual %}
        <div class="afiche-vista-previa-bloque">
          <p class="afiche-vista-previa-titulo">Afiche actual cargado:</p>
          <div class="afiche-vista-previa">
            <img src="{{ afiche_actual }}" alt="Afiche actual de {{ valores.titulo ?? 'la obra' }}" class="afiche-miniatura" loading="lazy">
          </div>
          <p class="campo-ayuda">Si no seleccionás una nueva imagen, se conservará el afiche actual.</p>
        </div>
      {% endif %}

      {% include 'parciales/campo.html.twig' with (reglas.afiche ?? {})|merge({
        nombre: 'afiche',
        etiqueta: es_edicion|default(false) and afiche_actual ? 'Cambiar afiche' : 'Imagen del afiche',
        tipo: 'file',
        aceptar: 'image/jpeg,image/png,image/webp',
        ayuda: 'Formatos admitidos: JPG, PNG o WebP (máx. 5 MB). Relación de aspecto sugerida vertical (2:3).',
        requerido: not (es_edicion|default(false) and afiche_actual),
        error: errores.afiche ?? null,
        zona_de_imagen: true
      }) only %}
    </fieldset>

    {# Botones finales #}
    <footer class="pie-formulario-acciones">
      <a href="/organizador/obras" class="boton boton-secundario">Cancelar</a>
      {% include 'parciales/boton.html.twig' with {
        texto: es_edicion|default(false) ? 'Guardar cambios' : 'Cargar obra',
        tipo: 'submit',
        variante: 'primario',
        tamano: 'grande'
      } only %}
    </footer>
  </form>
</div>
{% endblock %}
