{#
  Plantilla de alta y edición de sala indie en Programación (IC-35 / IC-36 / IC-45).
  Permite al organizador registrar y configurar las salas indie bajo su gestión,
  utilizando los parciales comunes: campo.html.twig, mensaje.html.twig y boton.html.twig.

  Variables recibidas:
  - valores: (array/map, opcional) Datos ingresados previamente para persistencia.
  - errores: (array/map, opcional) Diccionario de errores de validación por campo.
  - es_edicion: (bool, opcional, por defecto false) Si la pantalla corresponde a edición.
  - accion: (string, opcional, por defecto '/organizador/salas/nueva') URL de envío del formulario.
  - observacion_moderador: (string, opcional) Observación de moderación si la sala fue observada.
  - error_general: (string, opcional) Mensaje de error general de la operación.
  - mensaje_exito: (string, opcional) Mensaje de confirmación tras guardar la sala.
#}
{% extends 'base.html.twig' %}

{% block titulo %}{{ es_edicion ?? false ? 'Editar sala indie' : 'Nueva sala indie' }}{% endblock %}

{% block contenido %}
<div class="contenedor-formulario-amplio">
  {# Ruta de navegación secundaria (migas de pan) #}
  <nav class="navegacion-migas" aria-label="Migas de pan">
    <ol class="lista-migas">
      <li class="item-miga"><a href="/" class="enlace-miga">Inicio</a></li>
      <li class="separador-miga" aria-hidden="true">/</li>
      <li class="item-miga"><a href="/organizador" class="enlace-miga">Organización</a></li>
      <li class="separador-miga" aria-hidden="true">/</li>
      <li class="item-miga"><a href="/organizador/salas" class="enlace-miga">Mis salas</a></li>
      <li class="separador-miga" aria-hidden="true">/</li>
      <li class="item-miga miga-activa" aria-current="page">{{ es_edicion ?? false ? 'Editar sala' : 'Nueva sala' }}</li>
    </ol>
  </nav>

  {# Encabezado principal del formulario #}
  <header class="encabezado-formulario-solicitud">
    <div class="solicitud-texto-cabecera">
      <h1 class="solicitud-titulo">{{ es_edicion ?? false ? 'Editar sala indie' : 'Publicar una sala indie' }}</h1>
      <p class="solicitud-bajada">
        Configurá los datos de tu espacio, capacidad y parámetros de proyección para habilitar funciones en cartelera.
      </p>
    </div>
  </header>

  {# Alerta informativa si la sala cuenta con observaciones de moderación #}
  {% if observacion_moderador is defined and observacion_moderador %}
    {% include 'parciales/mensaje.html.twig' with {
      tipo: 'advertencia',
      titulo: 'Observaciones de moderación',
      mensaje: observacion_moderador
    } %}
  {% endif %}

  {# Alerta de error general #}
  {% if error_general is defined and error_general %}
    {% include 'parciales/mensaje.html.twig' with {
      tipo: 'error',
      titulo: 'No se pudo guardar la sala',
      mensaje: error_general
    } %}
  {% endif %}

  {# Alerta de confirmación exitosa #}
  {% if mensaje_exito is defined and mensaje_exito %}
    {% include 'parciales/mensaje.html.twig' with {
      tipo: 'exito',
      titulo: '¡Sala guardada!',
      mensaje: mensaje_exito
    } %}
  {% endif %}

  {# Formulario de alta y configuración de sala #}
  <form action="{{ accion ?? '/organizador/salas/nueva' }}" method="POST" enctype="multipart/form-data" class="formulario-sala" novalidate>
    {# Campo oculto para el token de protección contra ataques CSRF #}
    <input type="hidden" name="_csrf" value="{{ csrf }}">

    {# ==================================================================== #}
    {# SECCIÓN 1: DATOS DEL ESPACIO (IC-35)                                 #}
    {# ==================================================================== #}
    <fieldset class="seccion-formulario">
      <legend class="seccion-leyenda">
        <span class="seccion-titulo">Datos del espacio</span>
        <span class="seccion-subtitulo">Información pública visible en la ficha de la sala y en la cartelera.</span>
      </legend>

      {# Campo: Nombre de la sala #}
      {% include 'parciales/campo.html.twig' with {
        nombre: 'nombre',
        etiqueta: 'Nombre de la sala',
        tipo: 'text',
        valor: valores.nombre ?? '',
        placeholder: 'Ej: Cine Club El Galpón',
        ayuda: 'Nombre con el que el público identificará tu espacio.',
        requerido: true,
        error: errores.nombre ?? null
      } %}

      {# Campo: Descripción #}
      {% include 'parciales/campo.html.twig' with {
        nombre: 'descripcion',
        etiqueta: 'Descripción del espacio',
        tipo: 'textarea',
        filas: 4,
        valor: valores.descripcion ?? '',
        placeholder: 'Contale a la comunidad sobre el espacio, su historia, propuesta artística y equipamiento técnico...',
        ayuda: 'Breve reseña sobre el espacio y su propuesta cinematográfica.',
        requerido: true,
        error: errores.descripcion ?? null
      } %}

      <div class="fila-campos-doble">
        {# Campo: Dirección #}
        {% include 'parciales/campo.html.twig' with {
          nombre: 'direccion',
          etiqueta: 'Dirección (calle y número)',
          tipo: 'text',
          valor: valores.direccion ?? '',
          placeholder: 'Ej: Av. San Martín 450',
          ayuda: 'Ubicación física donde se realizan las proyecciones.',
          requerido: true,
          error: errores.direccion ?? null
        } %}

        {# Campo: Localidad #}
        {% include 'parciales/campo.html.twig' with {
          nombre: 'localidad',
          etiqueta: 'Localidad / Ciudad',
          tipo: 'text',
          valor: valores.localidad ?? '',
          placeholder: 'Ej: Luján',
          ayuda: 'Ciudad o municipio para filtrado geográfico.',
          requerido: true,
          error: errores.localidad ?? null
        } %}
      </div>
    </fieldset>

    {# ==================================================================== #}
    {# SECCIÓN 2: CAPACIDAD Y FOTOGRAFÍA                                    #}
    {# ==================================================================== #}
    <fieldset class="seccion-formulario">
      <legend class="seccion-leyenda">
        <span class="seccion-titulo">Capacidad e imagen</span>
        <span class="seccion-subtitulo">Aforo disponible para reservas y fotografía representativa.</span>
      </legend>

      <div class="fila-campos-doble">
        {# Campo: Capacidad de espectadores #}
        {% include 'parciales/campo.html.twig' with {
          nombre: 'capacidad',
          etiqueta: 'Capacidad de espectadores (butacas)',
          tipo: 'number',
          valor: valores.capacidad ?? '',
          placeholder: 'Ej: 60',
          ayuda: 'Cantidad máxima de espectadores que admite la sala.',
          requerido: true,
          error: errores.capacidad ?? null
        } %}

        {# Campo: Imagen de la sala #}
        {% include 'parciales/campo.html.twig' with {
          nombre: 'imagen',
          etiqueta: 'Fotografía de la sala',
          tipo: 'file',
          ayuda: 'Foto representativa de la sala (JPG, PNG o WebP, máx. 5 MB).',
          requerido: not (es_edicion ?? false),
          error: errores.imagen ?? null
        } %}
      </div>
    </fieldset>

    {# ==================================================================== #}
    {# SECCIÓN 3: PARÁMETROS DE FUNCIONES (IC-35)                           #}
    {# ==================================================================== #}
    <fieldset class="seccion-formulario">
      <legend class="seccion-leyenda">
        <span class="seccion-titulo">Parámetros de programación y funciones</span>
        <span class="seccion-subtitulo">Criterios técnicos para la coordinación de fechas y franjas horarias.</span>
      </legend>

      <div class="fila-campos-triple">
        {# Campo: Películas por función #}
        {% include 'parciales/campo.html.twig' with {
          nombre: 'peliculas_por_funcion',
          etiqueta: 'Películas por función',
          tipo: 'number',
          valor: valores.peliculas_por_funcion ?? 1,
          placeholder: '1',
          ayuda: 'Películas o cortos proyectados por función (mínimo 1).',
          requerido: true,
          error: errores.peliculas_por_funcion ?? null
        } %}

        {# Campo: Duración de la función #}
        {% include 'parciales/campo.html.twig' with {
          nombre: 'duracion_funcion',
          etiqueta: 'Duración de función (minutos)',
          tipo: 'number',
          valor: valores.duracion_funcion ?? '',
          placeholder: 'Ej: 120',
          ayuda: 'Duración promedio total estimada en minutos.',
          requerido: true,
          error: errores.duracion_funcion ?? null
        } %}

        {# Campo: Tiempo entre funciones #}
        {% include 'parciales/campo.html.twig' with {
          nombre: 'tiempo_entre_funciones',
          etiqueta: 'Intervalo entre funciones (minutos)',
          tipo: 'number',
          valor: valores.tiempo_entre_funciones ?? '',
          placeholder: 'Ej: 30',
          ayuda: 'Tiempo necesario para limpieza y rotación de público.',
          requerido: true,
          error: errores.tiempo_entre_funciones ?? null
        } %}
      </div>
    </fieldset>

    {# ==================================================================== #}
    {# ACCIONES FINALES DEL FORMULARIO                                      #}
    {# ==================================================================== #}
    <footer class="pie-formulario-acciones">
      <a href="/organizador/salas" class="boton boton-secundario">Cancelar</a>

      {% include 'parciales/boton.html.twig' with {
        texto: es_edicion ?? false ? 'Guardar cambios' : 'Publicar sala',
        tipo: 'submit',
        variante: 'primario',
        tamano: 'grande'
      } %}
    </footer>
  </form>
</div>
{% endblock %}
