{#
  Formulario de alta y edición para programar o modificar una función (IC-121 / IC-122 / IC-147 / E3-11.2 / E3-11.3 / E3-12.1).
  Permite al organizador elegir entre función programada o abrir a votación de títulos.
  Selecciona una de sus salas habilitadas, las obras del catálogo, la fecha y hora (en función programada),
  el precio de la entrada y el cupo.
  Una vez guardada con éxito, la función queda en estado programada o en votación de títulos.

  Variables recibidas:
  - es_edicion: (bool, opcional, por defecto false) Si la pantalla corresponde a edición de una función.
  - funcion_id: (string, opcional) Identificador UUID de la función a editar.
  - accion: (string, opcional) URL de destino del POST (por defecto '/organizador/funciones/nueva' o '/organizador/funciones/{id}/editar').
  - csrf: (string, obligatorio) Token CSRF para validar el envío POST.
  - salas: (list, obligatorio) Lista de salas propias del organizador habilitadas para proyectar.
  - obras: (list, obligatorio) Obras disponibles en el catálogo de IndieCinema.
  - valores: (map, opcional) Valores enviados por el usuario tras un error de validación o existentes en edición.
    En votación, cierre_fecha y cierre_hora son hasta cuándo se vota (EF-03.1).
  - errores: (map, opcional) Diccionario de mensajes de error de validación por campo.
  - error_general: (string, opcional) Mensaje de error general si falló la validación.
  - mensaje_exito: (string, opcional) Mensaje tras guardar exitosamente la función.
#}
{% extends 'organizador.html.twig' %}

{% block titulo %}{{ es_edicion ?? false ? 'Editar función' : 'Programar una función' }}{% endblock %}

{% block seccion %}{{ es_edicion ?? false ? 'funciones' : 'programar' }}{% endblock %}

{% block panel %}
<div class="contenedor">
  {# Migas de pan para ubicación dentro del panel de organizador #}
  <nav class="navegacion-migas" aria-label="Migas de pan">
    <ol class="lista-migas">
      <li class="item-miga"><a href="/" class="enlace-miga">Inicio</a></li>
      <li class="separador-miga" aria-hidden="true">/</li>
      <li class="item-miga"><a href="/organizador/funciones" class="enlace-miga">Mis funciones</a></li>
      <li class="separador-miga" aria-hidden="true">/</li>
      <li class="item-miga miga-activa" aria-current="page">{{ es_edicion ?? false ? 'Editar función' : 'Programar función' }}</li>
    </ol>
  </nav>

  {# Encabezado descriptivo de la pantalla #}
  <header class="encabezado-formulario-solicitud">
    <div class="solicitud-texto-cabecera">
      <h1 class="solicitud-titulo">{{ es_edicion ?? false ? 'Editar función' : 'Programar una función' }}</h1>
      <p class="solicitud-bajada">
        {{ es_edicion ?? false
          ? 'Modificá la sala, las obras del catálogo, la fecha, el horario, el precio o el cupo de tu función.'
          : 'Elegí tu sala, las obras del catálogo, la fecha y horario, el precio de la entrada y el cupo disponible. Al guardarla, tu función aparecerá en la cartelera.'
        }}
      </p>
    </div>
    <div class="solicitud-accion-cabecera">
      <a href="/organizador/funciones" class="boton boton-secundario">Ver mis funciones</a>
    </div>
  </header>

  {# Si el envío volvió con errores: «Revisá N campos» con un link a cada uno, o la regla de negocio
     que no se cumplió, como que se pisa con otra función de la sala (E4-10.5) #}
  {% include 'parciales/resumen_de_errores.html.twig' with {
    errores: errores ?? {},
    error_general: error_general ?? null,
    titulo: es_edicion ?? false ? 'No se pudo guardar la función' : 'No se pudo programar la función'
  } only %}

  {# Alerta de confirmación exitosa #}
  {% if mensaje_exito is defined and mensaje_exito %}
    {% include 'parciales/mensaje.html.twig' with {
      tipo: 'exito',
      titulo: es_edicion ?? false ? '¡Función actualizada con éxito!' : '¡Función programada con éxito!',
      mensaje: mensaje_exito
    } only %}
  {% endif %}

  {# Si el organizador no tiene salas habilitadas, advertirle antes de que intente enviar el formulario #}
  {% if salas is empty %}
    {% include 'parciales/mensaje.html.twig' with {
      tipo: 'advertencia',
      titulo: 'No tenés salas habilitadas',
      mensaje: 'Para poder programar una función necesitás tener al menos una sala habilitada por un administrador.'
    } only %}
    <div class="solicitud-acciones-inferior">
      {% include 'parciales/boton.html.twig' with {
        texto: 'Publicar una sala',
        url: '/solicitar-sala',
        variante: 'primario'
      } only %}
      <a href="/organizador/funciones" class="boton boton-secundario">Volver a mis funciones</a>
    </div>
  {% else %}
    {# El formulario a la izquierda y los parámetros de la sala a la derecha, como en el wireframe #}
    <div class="panel-organizador-grid">
    <div class="panel-organizador-principal">
    {# Formulario principal de alta o edición de función. Sin novalidate: el navegador también valida #}
    {% set url_accion = accion ?? ((es_edicion ?? false and funcion_id is defined) ? ('/organizador/funciones/' ~ funcion_id ~ '/editar') : '/organizador/funciones/nueva') %}
    {% set modo_actual = valores.modo|default('programada') %}
    {% set es_votacion = not (es_edicion ?? false) and modo_actual == 'en_votacion_titulos' %}
    {# data-validar-en-linea: los errores mientras se carga, con los mensajes del backend (E4-09.1) #}
    <form action="{{ url_accion }}" method="POST" class="formulario-sala formulario-alta-funcion" data-validar-en-linea>
      {# Token de protección CSRF #}
      <input type="hidden" name="_csrf" value="{{ csrf }}">

      {# ==================================================================== #}
      {# MODO DE PUBLICACIÓN: PROGRAMADA VS VOTACIÓN (E3-12.1 / IC-147)       #}
      {# ==================================================================== #}
      {% if not (es_edicion ?? false) %}
      {# id="modo": el link del resumen de errores trae acá (E4-10.5) #}
      <fieldset id="modo" class="seccion-formulario seccion-modo-funcion" data-seccion-modo>
        <legend class="seccion-leyenda">
          <span class="seccion-titulo">Modo de publicación</span>
          <span class="seccion-subtitulo">Elegí si la función ya tiene fecha fija o si abrís una votación de títulos.</span>
        </legend>

        <div class="selector-modo-funcion" role="radiogroup" aria-label="Modo de publicación">
          <label class="opcion-modo-funcion{% if modo_actual == 'programada' %} seleccionada{% endif %}">
            <input
              type="radio"
              name="modo"
              value="programada"
              class="opcion-modo-radio"
              {% if errores.modo is defined and errores.modo %}aria-invalid="true" aria-describedby="error-modo"{% endif %}
              {% if modo_actual == 'programada' %}checked{% endif %}
            >
            <span class="opcion-modo-contenido">
              <strong class="opcion-modo-titulo">Función programada</strong>
              <span class="opcion-modo-descripcion">Definí sala, obras, fecha y horario. La función se publicará directamente en la cartelera.</span>
            </span>
          </label>

          <label class="opcion-modo-funcion{% if modo_actual == 'en_votacion_titulos' %} seleccionada{% endif %}">
            <input
              type="radio"
              name="modo"
              value="en_votacion_titulos"
              class="opcion-modo-radio"
              {% if errores.modo is defined and errores.modo %}aria-invalid="true" aria-describedby="error-modo"{% endif %}
              {% if modo_actual == 'en_votacion_titulos' %}checked{% endif %}
            >
            <span class="opcion-modo-contenido">
              <strong class="opcion-modo-titulo">Abrir a votación de títulos</strong>
              <span class="opcion-modo-descripcion">Las obras seleccionadas serán candidatas a votación hasta el cierre que elijas. La fecha y horario se definirán al finalizar la votación.</span>
            </span>
          </label>
        </div>
        {# El error lleva id y cada radio lo apunta con aria-describedby: así el lector de
           pantalla lo lee al pararse en la opción y no sólo al aparecer (E4-09.3). #}
        {% if errores.modo is defined and errores.modo %}
          <span id="error-modo" class="campo-error" role="alert">
            <span class="error-icono" aria-hidden="true">⚠️</span> {{ errores.modo }}
          </span>
        {% endif %}
      </fieldset>
      {% endif %}

      {# ==================================================================== #}
      {# SECCIÓN 1: SALA PROPIA                                               #}
      {# ==================================================================== #}
      <fieldset class="seccion-formulario">
        <legend class="seccion-leyenda">
          <span class="seccion-titulo">Sala de proyección</span>
          <span class="seccion-subtitulo">Seleccioná una de tus salas habilitadas para llevar a cabo la proyección.</span>
        </legend>

        {# Genera la lista de opciones para el selector de sala propia #}
        {% set opciones_salas = [] %}
        {% for s in salas %}
          {% set capacidad_texto = s.capacidad ?? (s.datos.capacidad ?? null) %}
          {% set localidad_texto = s.localidad ?? (s.datos.localidad ?? null) %}
          {% set etiqueta_sala = s.nombre ?? (s.datos.nombre ?? 'Sala sin nombre') %}
          {% if capacidad_texto %}
            {% set etiqueta_sala = etiqueta_sala ~ ' (' ~ capacidad_texto ~ ' butacas' ~ (localidad_texto ? ' · ' ~ localidad_texto : '') ~ ')' %}
          {% endif %}
          {% set opciones_salas = opciones_salas|merge([{
            valor: s.id,
            etiqueta: etiqueta_sala
          }]) %}
        {% endfor %}

        {% include 'parciales/campo.html.twig' with reglas.sala_id|merge({
          nombre: 'sala_id',
          etiqueta: 'Sala',
          tipo: 'select',
          placeholder: 'Seleccioná una sala...',
          opciones: opciones_salas,
          valor: valores.sala_id ?? '',
          requerido: true,
          errores: errores ?? {},
          ayuda: 'Solo se listan las salas propias que ya fueron habilitadas.'
        }) only %}
      </fieldset>

      {# ==================================================================== #}
      {# SECCIÓN 2: OBRAS DEL CATÁLOGO                                        #}
      {# ==================================================================== #}
      {# id="obras": el link del resumen de errores trae acá (E4-10.5) #}
      {# data-candidatas-minimas y data-error-candidatas: el mínimo de obras de una votación y su
         mensaje, los mismos del servidor (FormularioDeFuncion::reglas()), para que ModoFuncion
         frene el envío antes de mandarlo (F-01.6). #}
      <fieldset id="obras" class="seccion-formulario" data-candidatas-minimas="{{ reglas.obras.candidatas_minimas|default(2) }}" data-error-candidatas="{{ reglas.obras.mensajes.candidatas|default('Para abrir una votación elegí al menos dos obras candidatas.') }}">
        <legend class="seccion-leyenda">
          <span class="seccion-titulo">Obras del catálogo</span>
          <span class="seccion-subtitulo" data-obras-subtitulo>{{ es_votacion ? 'Elegí las obras candidatas que participarán de la votación.' : 'Elegí la obra o los títulos a proyectar en la función.' }}</span>
        </legend>

        {# Arriba del if: lo miran las casillas y el mensaje de abajo, y tiene que estar definido
           aunque no haya obras que mostrar. #}
        {% set error_obras = errores.obras ?? (errores.obras_ids ?? (errores.obra_id ?? null)) %}
        {% if obras is empty %}
          {% include 'parciales/mensaje.html.twig' with {
            tipo: 'info',
            mensaje: 'No hay obras cargadas actualmente en el catálogo.'
          } only %}
        {% else %}
          {# Cuadrícula accesible de selección de obras con casillas de verificación #}
          <div class="cuadricula-seleccion-obras" role="group" aria-label="Selección de obras del catálogo">
            {% set seleccionadas = valores.obras ?? (valores.obras_ids ?? (valores.obra_id is defined ? [valores.obra_id] : [])) %}
            {% for obra in obras %}
              {% set marcada = obra.id in seleccionadas %}
              <label class="tarjeta-seleccion-obra{% if marcada %} seleccionada{% endif %}">
                <input
                  type="checkbox"
                  name="obras[]"
                  value="{{ obra.id }}"
                  class="campo-control-checkbox"
                  {% if error_obras %}aria-invalid="true" aria-describedby="error-obras"{% endif %}
                  {% if marcada %}checked{% endif %}
                >
                <span class="info-seleccion-obra">
                  <span class="titulo-seleccion-obra">{{ obra.titulo }}</span>
                  <span class="meta-seleccion-obra">
                    {{ obra.anio ?? '' }}
                    {% set dur = obra.duracion ?? (obra.duracionMinutos ?? null) %}
                    {% if dur %} · {{ dur }} min{% endif %}
                    {% if obra.director is defined and obra.director %} · Dir: {{ obra.director }}{% endif %}
                  </span>
                </span>
              </label>
            {% endfor %}
          </div>
        {% endif %}

        {# Mensaje de error para la selección de obras #}
        {# Con id, y cada casilla lo apunta: el lector lo lee al pararse en una obra (E4-09.3) #}
        {% if error_obras %}
          <span id="error-obras" class="campo-error" role="alert">
            <span class="error-icono" aria-hidden="true">⚠️</span> {{ error_obras }}
          </span>
        {% endif %}
        <span class="campo-ayuda" data-obras-ayuda{% if error_obras %} hidden{% endif %}>{{ es_votacion ? 'Marcá al menos dos obras del catálogo: serán las candidatas de la votación.' : 'Marcá al menos una obra del catálogo para esta función.' }}</span>
      </fieldset>

      {# ==================================================================== #}
      {# SECCIÓN 3: FECHA Y HORA                                              #}
      {# ==================================================================== #}
      <fieldset class="seccion-formulario" data-seccion-fecha-hora>
        <legend class="seccion-leyenda">
          <span class="seccion-titulo">Fecha y horario</span>
          <span class="seccion-subtitulo">Día y hora pactados para la proyección en sala.</span>
        </legend>

        <div class="fila-campos-doble">
          {# Campo: Fecha de proyección. Sin autocompletar: que el navegador no sugiera fechas de otras
             funciones (E4-10.5) #}
          {% include 'parciales/campo.html.twig' with reglas.fecha|merge({
            nombre: 'fecha',
            etiqueta: 'Fecha de proyección',
            tipo: 'date',
            valor: valores.fecha ?? '',
            requerido: (es_edicion ?? false) or not es_votacion,
            errores: errores ?? {},
            autocompletar: 'off',
            ayuda: 'La fecha debe ser a partir de hoy o futura.'
          }) only %}

          {# Campo: Horario de inicio #}
          {% include 'parciales/campo.html.twig' with reglas.hora|merge({
            nombre: 'hora',
            etiqueta: 'Horario de inicio',
            tipo: 'time',
            valor: valores.hora ?? '',
            placeholder: 'Ej: 20:30',
            requerido: (es_edicion ?? false) or not es_votacion,
            errores: errores ?? {},
            ayuda: 'Hora estimada en la que comienza la función.'
          }) only %}
        </div>
      </fieldset>

      {# ==================================================================== #}
      {# SECCIÓN 3 BIS: CIERRE DE LA VOTACIÓN (EF-03.1)                       #}
      {# ==================================================================== #}
      {# Sólo al abrir una votación: hasta cuándo se vota. Al llegar la votación se cierra sola con
         la más votada; el organizador la puede cerrar antes desde la ficha. ModoFuncion la muestra
         en ese modo y oculta la de fecha y horario; sin JavaScript se ven las dos, y el servidor
         usa la que corresponde al modo elegido. #}
      {% if not (es_edicion ?? false) %}
      <fieldset class="seccion-formulario" data-seccion-cierre-votacion>
        <legend class="seccion-leyenda">
          <span class="seccion-titulo">Cierre de la votación</span>
          <span class="seccion-subtitulo">Hasta cuándo votan los espectadores. Al llegar, la votación se cierra sola con el título más votado.</span>
        </legend>

        <div class="fila-campos-doble">
          {% include 'parciales/campo.html.twig' with (reglas.cierre_fecha ?? {})|merge({
            nombre: 'cierre_fecha',
            etiqueta: 'Día de cierre',
            tipo: 'date',
            valor: valores.cierre_fecha ?? '',
            requerido: es_votacion,
            errores: errores ?? {},
            autocompletar: 'off',
            ayuda: 'Tiene que ser futuro.'
          }) only %}

          {% include 'parciales/campo.html.twig' with (reglas.cierre_hora ?? {})|merge({
            nombre: 'cierre_hora',
            etiqueta: 'Hora de cierre',
            tipo: 'time',
            valor: valores.cierre_hora ?? '',
            placeholder: 'Ej: 23:00',
            requerido: es_votacion,
            errores: errores ?? {},
            ayuda: 'Podés cerrarla antes desde la ficha de la función.'
          }) only %}
        </div>
      </fieldset>
      {% endif %}

      {# ==================================================================== #}
      {# SECCIÓN 4: PRECIO Y CUPO                                             #}
      {# ==================================================================== #}
      <fieldset class="seccion-formulario">
        <legend class="seccion-leyenda">
          <span class="seccion-titulo">Precio y cupo</span>
          <span class="seccion-subtitulo">Valores de acceso a la función y cantidad de localidades disponibles.</span>
        </legend>

        <div class="fila-campos-doble">
          {# Campo: Precio de la entrada.
             Va en un campo de texto y no numérico (E4-09.4): en un campo numérico Chromium descarta
             la coma sin avisar y «1500,50» queda en 150050, y además no aplica el pattern. Como texto
             sí vale el patrón que manda el back, que acepta la coma y el punto, y con inputmode="decimal"
             el celular sigue abriendo el teclado numérico. #}
          {% include 'parciales/campo.html.twig' with reglas.precio|merge({
            nombre: 'precio',
            etiqueta: 'Precio de la entrada ($)',
            tipo: 'text',
            modo_de_entrada: 'decimal',
            valor: valores.precio ?? '',
            placeholder: 'Ej: 1500,50',
            requerido: true,
            errores: errores ?? {},
            ayuda: 'Los centavos van con coma o con punto. Poné 0 para función gratuita o a la gorra.'
          }) only %}

          {# Campo: Cupo de butacas disponibles #}
          {% include 'parciales/campo.html.twig' with reglas.cupo|merge({
            nombre: 'cupo',
            etiqueta: 'Cupo disponible (butacas)',
            tipo: 'number',
            valor: valores.cupo ?? '',
            placeholder: 'Ej: 50',
            requerido: true,
            errores: errores ?? {},
            ayuda: 'Cantidad de entradas disponibles. No puede superar la capacidad de la sala.'
          }) only %}
        </div>
      </fieldset>

      {# ==================================================================== #}
      {# ACCIONES FINALES                                                     #}
      {# ==================================================================== #}
      {# Banner informativo de publicación o actualización como en Figma #}
      <div class="aviso-publicacion-funcion" role="status" data-aviso-publicacion>
        <span class="aviso-icono" aria-hidden="true">💡</span>
        <div class="aviso-contenido">
          <strong class="aviso-titulo" data-aviso-titulo>{{ es_edicion ?? false ? 'Actualización directa' : (es_votacion ? 'Apertura de votación' : 'Publicación directa') }}</strong>
          <p class="aviso-texto" data-aviso-texto>
            {% if es_edicion ?? false %}
              Al guardar los cambios, la función mantendrá sus datos actualizados en la cartelera y en su ficha para reservas.
            {% elseif es_votacion %}
              Al guardar la función, quedará en estado <strong>en votación de títulos</strong> con las obras seleccionadas como candidatas. La fecha y horario se definirán al finalizar la votación.
            {% else %}
              Al guardar la función, quedará en estado <strong>programada</strong> y aparecerá disponible inmediatamente en la cartelera para reservas.
            {% endif %}
          </p>
        </div>
      </div>

      {# El principal primero, como en el wireframe #}
      <footer class="pie-formulario-acciones">
        {% set texto_boton = es_edicion ?? false ? 'Guardar cambios' : (es_votacion ? 'Abrir a votación' : 'Programar función') %}
        {% include 'parciales/boton.html.twig' with {
          texto: texto_boton,
          tipo: 'submit',
          variante: 'primario',
          id: 'boton-enviar-funcion'
        } only %}
        <a href="/organizador/funciones" class="boton boton-secundario">Descartar</a>
      </footer>
    </form>
    </div>

    {# Los parámetros que la función hereda de la sala, al costado como en el wireframe. Hay una
       lista por sala: con JavaScript se ve sólo la de la sala elegida
       (componentes/parametros-de-sala.js); sin él, se ven todas, cada una con su nombre #}
    <aside class="panel-organizador-lateral" aria-labelledby="titulo-parametros-sala" data-parametros-de-sala>
      <div class="tarjeta-parametros-sala">
        <h2 id="titulo-parametros-sala" class="parametros-sala-titulo">Parámetros heredados de la sala</h2>
        <p class="parametros-sala-pie" data-sin-sala hidden>Elegí una sala para ver sus parámetros.</p>
        {% for s in salas %}
          <section class="parametros-sala-grupo" data-sala="{{ s.id }}">
            <h3 class="parametros-sala-nombre">{{ s.nombre }}</h3>
            <dl class="parametros-sala-lista">
              <div class="parametro-item">
                <dt>Capacidad</dt>
                <dd>{{ s.capacidad }}</dd>
              </div>
              <div class="parametro-item">
                <dt>Películas por función</dt>
                <dd>{{ s.peliculas_por_funcion }}</dd>
              </div>
              <div class="parametro-item">
                <dt>Duración máxima</dt>
                <dd>{{ s.duracion_funcion }} min</dd>
              </div>
              <div class="parametro-item">
                <dt>Tiempo entre funciones</dt>
                <dd>{{ s.tiempo_entre_funciones }} min</dd>
              </div>
            </dl>
          </section>
        {% endfor %}
        <p class="parametros-sala-pie">Los parámetros salen de la configuración de la sala.</p>
      </div>
    </aside>
  </div>
  {% endif %}
</div>
{% endblock %}
