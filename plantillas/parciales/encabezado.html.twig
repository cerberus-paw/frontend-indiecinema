{#
  Parcial de encabezado (IC-43 / IC-44 / IC-45 / IC-94 / IC-97)
  Contiene la barra de navegación superior fija, el logotipo vectorial oficial,
  el buscador accesible hacia la cartelera, la navegación pública
  y el menú adaptativo de usuario según el rol (espectador, organizador, moderador y administrador)
  con cierre de sesión seguro por POST.
#}
{# Resuelve de forma segura el usuario en sesión o null para evitar errores en modo estricto de Twig #}
{% set usr = usuario ?? null %}
{# Resuelve la ruta completa normalizada combinando el prefijo del subsistema y la ruta actual #}
{% set ruta = (prefijo ?? '') ~ (ruta_actual ?? '') %}
{# Elemento semántico header que representa la cabecera superior y fija de la página #}
<header class="encabezado">
  {# Contenedor con ancho máximo centrado para mantener alineación consistente con el resto de la interfaz #}
  <div class="contenedor encabezado-contenedor">

    {# Sección del logotipo oficial vectorial de IndieCinema #}
    <div class="encabezado-marca">
      {# Enlace hacia la portada principal con etiqueta accesible #}
      <a href="/" class="marca-enlace" aria-label="IndieCinema Inicio">
        {# Logotipo vectorial oficial de la identidad visual E1 (icono y tipografía integrada) #}
        <img src="/estaticos/img/logo-horizontal-dark.svg" alt="IndieCinema" class="marca-logo-img" width="93" height="40">
      {# Cierre del enlace del logo #}
      </a>
    {# Cierre de la sección de marca #}
    </div>

    {# Sección del buscador rápido hacia la cartelera #}
    <div class="encabezado-buscador">
      {# Formulario de búsqueda accesible por GET hacia la cartelera #}
      <form class="buscador-form" action="/cartelera" method="get" role="search">
        {# Etiqueta para lectores de pantalla oculta visualmente mediante la clase .sr-only por motivos estéticos #}
        <label for="campo-busqueda" class="sr-only">Buscar en la cartelera por película, director o sala</label>
        {# Contenedor relativo que posiciona el icono de lupa dentro del campo de texto #}
        <div class="buscador-caja">
          {# Icono decorativo de lupa posicionado de forma absoluta dentro del input #}
          <span class="buscador-icono" aria-hidden="true">🔍</span>
          {# Campo de entrada de tipo search que permite autocompletado y borrado nativo #}
          <input type="search" id="campo-busqueda" name="q" class="buscador-input" placeholder="Película, director o sala" aria-label="Buscar en la cartelera por película, director o sala" value="{{ filtros.q ?? consulta_busqueda ?? '' }}">
        {# Cierre de la caja del buscador #}
        </div>
      {# Cierre del formulario del buscador #}
      </form>
    {# Cierre de la sección del buscador #}
    </div>

    {# Navegación principal estructurada semánticamente con nav #}
    <nav class="navegacion-principal" aria-label="Navegación principal">
      {# Lista no ordenada de enlaces de navegación pública #}
      <ul class="nav-lista">
        {# Enlace a Cartelera: ruta /cartelera #}
        <li>
          <a href="/cartelera" class="nav-enlace{% if ruta == '/cartelera' or ruta starts with '/cartelera' %} activo{% endif %}">Cartelera</a>
        </li>
        {# Enlace a la sección de Salas indie registradas #}
        <li>
          <a href="/salas" class="nav-enlace{% if ruta starts with '/salas' %} activo{% endif %}">Salas</a>
        </li>
        {# Enlace a la explicación de la dinámica colaborativa, una sección de «Acerca de IndieCinema» #}
        <li>
          <a href="/acerca-de#como-funciona" class="nav-enlace">Cómo funciona</a>
        </li>
        {# Enlace a «Acerca de IndieCinema»: quiénes somos y cómo funciona el sitio #}
        <li>
          <a href="/acerca-de" class="nav-enlace{% if ruta starts with '/acerca-de' %} activo{% endif %}">Acerca de</a>
        </li>

        {# Acceso directo en barra para Organizador: lo ven el organizador y los roles que lo alcanzan (moderador y administrador) #}
        {% if usr and usr.alcanza('organizador') %}
          <li class="nav-item-rol">
            <a href="/organizador/salas" class="nav-enlace enlace-rol{% if ruta starts with '/organizador/salas' %} activo{% endif %}" title="Mis salas">
              Mis salas
            </a>
          </li>
        {% endif %}
      {# Cierre de la lista de navegación principal #}
      </ul>
    {# Cierre del elemento nav #}
    </nav>

    {# Bloque de sesión: muestra el menú del usuario autenticado o los botones de acceso para invitados #}
    <div class="encabezado-usuario">
      {# Si existe un usuario en sesión, se renderiza su tarjeta y menú desplegable #}
      {% if usr %}
        {# Se utiliza la etiqueta HTML5 nativa 'details' para accesibilidad y funcionamiento sin JS #}
        <details class="usuario-desplegable" id="menu-usuario">
          {# Elemento summary interactivo que sirve como disparador accesible del menú desplegable #}
          <summary class="usuario-resumen" aria-haspopup="menu" aria-label="Menú de usuario">
            {# Avatar circular generado dinámicamente con la primera letra del nombre #}
            <span class="usuario-avatar" aria-hidden="true">
              {{ usr.nombre ? usr.nombre|slice(0, 1)|upper : 'U' }}
            </span>
            {# Contenedor con los datos textuales de la sesión #}
            <div class="usuario-info">
              {# Muestra el nombre público del usuario #}
              <span class="usuario-nombre">{{ usr.nombre ?? 'Usuario' }}</span>
              {# Insignia visual con el rol #}
              <span class="usuario-rol rol-{{ usr.rol.value }}">{{ usr.rol.value }}</span>
            {# Cierre de información del usuario #}
            </div>
            {# Flecha indicadora de apertura #}
            <span class="desplegable-flecha" aria-hidden="true">▾</span>
          {# Cierre de summary #}
          </summary>

          {# Menú flotante con lista completa de acciones disponibles para el usuario según su rol #}
          <div class="usuario-menu-flotante" role="menu">
            {# Encabezado informativo del menú #}
            <div class="menu-cabecera">
              <strong class="menu-usuario-nombre">{{ usr.nombre ?? 'Usuario' }}</strong>
              <span class="menu-usuario-rol">Rol activo: {{ usr.rol.value|capitalize }}</span>
            </div>

            {# Línea divisoria visual #}
            <div class="menu-separador" role="separator"></div>

            {# Título de la sección de Mi Cuenta (común a todos los usuarios autenticados) #}
            <div class="menu-seccion-titulo">Mi cuenta</div>
            {# Enlace al panel principal de cuenta #}
            <a href="/cuenta/" class="menu-item" role="menuitem">
              <span class="menu-icono" aria-hidden="true">👤</span> Panel de mi cuenta
            </a>
            {# Quien todavía no es organizador puede pedirlo con la solicitud #}
            {% if not usr.alcanza('organizador') %}
              <a href="/cuenta/solicitud" class="menu-item" role="menuitem">
                <span class="menu-icono" aria-hidden="true">🎬</span> Abrir una sala
              </a>
            {% endif %}

            {# Sección condicional de opciones del Organizador, también para los roles que lo alcanzan #}
            {% if usr.alcanza('organizador') %}
              <div class="menu-separador" role="separator"></div>
              <div class="menu-seccion-titulo">Panel del Organizador</div>
              <a href="/organizador/salas" class="menu-item" role="menuitem">
                <span class="menu-icono" aria-hidden="true">🏛️</span> Mis salas
              </a>
              <a href="/organizador/funciones" class="menu-item" role="menuitem">
                <span class="menu-icono" aria-hidden="true">🎞️</span> Mis funciones
              </a>
              <a href="/organizador/funciones/nueva" class="menu-item" role="menuitem">
                <span class="menu-icono" aria-hidden="true">🎬</span> Programar función
              </a>
              <a href="/organizador/salas/nueva" class="menu-item" role="menuitem">
                <span class="menu-icono" aria-hidden="true">➕</span> Publicar una sala
              </a>
            {% endif %}

            {# Sección de administración: sólo el administrador, el único rol que alcanza esas rutas #}
            {% if usr.alcanza('administrador') %}
              <div class="menu-separador" role="separator"></div>
              <div class="menu-seccion-titulo">Administración</div>
              <a href="/cuenta/administracion/usuarios" class="menu-item" role="menuitem">
                <span class="menu-icono" aria-hidden="true">👥</span> Usuarios y roles
              </a>
              <a href="/cuenta/administracion/solicitudes" class="menu-item" role="menuitem">
                <span class="menu-icono" aria-hidden="true">📨</span> Solicitudes
              </a>
              <a href="/administracion/salas" class="menu-item" role="menuitem">
                <span class="menu-icono" aria-hidden="true">✅</span> Habilitar salas
              </a>
            {% endif %}

            {# Separador visual antes del botón de cierre de sesión #}
            <div class="menu-separador" role="separator"></div>
            {# Formulario POST con token CSRF para invalidar la sesión de forma segura contra ataques CSRF #}
            <form action="/cuenta/salir" method="POST" class="form-menu-item form-cerrar-sesion">
              <input type="hidden" name="_csrf" value="{{ csrf }}">
              <button type="submit" class="menu-item menu-item-cerrar" role="menuitem">
                <span class="menu-icono" aria-hidden="true">🚪</span> Cerrar sesión
              </button>
            </form>
          {# Cierre del menú flotante #}
          </div>
        {# Cierre del componente details #}
        </details>
      {# Rama alternativa: cuando no hay ningún usuario autenticado en la sesión #}
      {% else %}
        {# Contenedor de botones de ingreso y registro para visitantes #}
        <div class="usuario-invitado">
          {# Enlace hacia el formulario de inicio de sesión de cuentas #}
          <a href="/cuenta/ingresar" class="nav-enlace enlace-ingresar">Ingresar</a>
          {# Botón de acción destacada para registrarse en el subsistema de cuentas #}
          <a href="/cuenta/registro" class="boton boton-primario boton-chico">Crear cuenta</a>
        {# Cierre del contenedor de visitante #}
        </div>
      {# Cierre del condicional principal de usuario #}
      {% endif %}
    {# Cierre de la sección de usuario #}
    </div>
  {# Cierre del contenedor del encabezado #}
  </div>
{# Cierre de la cabecera semántica #}
</header>
