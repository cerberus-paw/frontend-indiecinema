{#
  Las dos partes de los reportes (EF-09), como pestañas que son enlaces: lo que conviene hacer y
  los totales. Llevan el período elegido, así cambiar de una a otra no lo pierde.

  Parámetros recibidos:
  - activa: (string) 'sugerencias' o 'funciones'.
  - periodo: desde y hasta (AAAA-MM-DD).
#}
{% set consulta = '?desde=' ~ periodo.desde|url_encode ~ '&hasta=' ~ periodo.hasta|url_encode %}
<nav class="reporte-pestanas" aria-label="Partes del reporte">
  <a href="/recaudacion/reportes{{ consulta }}" class="reporte-pestana{% if activa == 'sugerencias' %} activa{% endif %}"{% if activa == 'sugerencias' %} aria-current="page"{% endif %}>Qué conviene hacer</a>
  <a href="/recaudacion/reportes/funciones{{ consulta }}" class="reporte-pestana{% if activa == 'funciones' %} activa{% endif %}"{% if activa == 'funciones' %} aria-current="page"{% endif %}>Funciones y meses</a>
</nav>
