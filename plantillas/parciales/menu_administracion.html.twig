{#
  Barra lateral de las pantallas del administrador y del moderador, como los wireframes de la E2
  (administracion-usuarios-parametros y moderacion-solicitudes), armada con
  parciales/panel_menu.html.twig. Las dos comparten las bandejas de moderación, pero son paneles
  distintos (F-02.23): el moderador ve el «Panel de moderación», sólo con sus bandejas, y el
  administrador el «Panel de administración», con lo suyo además. Cada uno con su color.
  El logo del administrador lleva a su panel, porque la portada pública lo redirige ahí; el del
  moderador, a la portada, porque también usa el sitio, como el organizador. Al moderador, el grupo
  de las bandejas no se llama «Moderación», que ya es el nombre de su panel.

  Parámetros recibidos:
  - activa: (string) la sección actual: 'usuarios', 'reservas', 'reportes', 'reparto',
    'liquidaciones', 'comercios', 'solicitudes', 'documentos', 'obras' o 'denuncias'.
  - usuario: el usuario en sesión.
  - csrf: el token del formulario para salir.
#}
{% set es_admin = usuario and usuario.alcanza('administrador') %}
{% set moderacion = { titulo: es_admin ? 'Moderación' : 'Bandejas', secciones: [
  { clave: 'solicitudes', texto: 'Solicitudes de sala', url: '/moderacion/solicitudes', icono: 'sobre' },
  { clave: 'documentos', texto: 'Documentos', url: '/moderacion/documentos', icono: 'documento' },
  { clave: 'obras', texto: 'Obras', url: '/moderacion/obras', icono: 'pelicula' },
  { clave: 'denuncias', texto: 'Denuncias', url: '/moderacion/denuncias', icono: 'bandera' },
] } %}
{% if es_admin %}
  {% include 'parciales/panel_menu.html.twig' with {
    rol: 'administrador',
    nombre: 'Panel de administración',
    icono: 'engranaje',
    inicio: '/cuenta/administracion/usuarios',
    sitio: false,
    grupos: [
      { titulo: 'Plataforma', secciones: [
        { clave: 'usuarios', texto: 'Usuarios y roles', url: '/cuenta/administracion/usuarios', icono: 'personas' },
        { clave: 'reservas', texto: 'Reservas', url: '/funcion/administracion/reservas', icono: 'entrada' },
      ] },
      { titulo: 'Recaudación', secciones: [
        { clave: 'reportes', texto: 'Reportes', url: '/recaudacion/reportes', icono: 'grafico' },
        { clave: 'reparto', texto: 'Reparto', url: '/recaudacion/administracion/reparto', icono: 'porcentaje' },
        { clave: 'liquidaciones', texto: 'Liquidaciones', url: '/recaudacion/administracion/liquidaciones', icono: 'moneda' },
        { clave: 'comercios', texto: 'Comercios', url: '/recaudacion/administracion/comercios', icono: 'tienda' },
      ] },
      moderacion,
    ],
    activa: activa,
    usuario: usuario,
    csrf: csrf,
  } only %}
{% else %}
  {% include 'parciales/panel_menu.html.twig' with {
    rol: 'moderador',
    nombre: 'Panel de moderación',
    icono: 'escudo',
    inicio: '/',
    sitio: true,
    grupos: [moderacion],
    activa: activa,
    usuario: usuario,
    csrf: csrf,
  } only %}
{% endif %}
