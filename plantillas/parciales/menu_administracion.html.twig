{#
  Barra lateral de las pantallas del administrador, como los wireframes de la E2: el logo, las
  secciones que ya tienen pantalla y, al pie, quién está en sesión y el botón para salir. Reemplaza
  al encabezado del sitio, así que el cierre de sesión tiene que estar acá. Las secciones van en
  los dos grupos de los wireframes: «Administración» (administracion-usuarios-parametros), sólo
  para el administrador, y «Moderación» (moderacion-solicitudes), para el moderador y el
  administrador. Cada uno ve sólo las secciones que puede abrir.

  Parámetros recibidos:
  - activa: (string) la sección actual: 'usuarios', 'reservas', 'reportes', 'reparto' o
    'solicitudes'.
  - usuario: el usuario en sesión.
  - csrf: el token del formulario para salir.
#}
{% set es_admin = usuario and usuario.alcanza('administrador') %}
<aside class="panel-menu">
  {# El logo lleva al inicio del panel: la portada pública redirige ahí al administrador; el moderador empieza en la bandeja #}
  <a href="{{ es_admin ? '/cuenta/administracion/usuarios' : '/moderacion/solicitudes' }}" class="panel-marca" aria-label="IndieCinema: inicio del panel">
    <img src="/estaticos/img/logo-horizontal-dark.svg" alt="IndieCinema" width="140" height="60">
  </a>

  {% if es_admin %}
  <nav aria-label="Administración">
    <p class="panel-menu-titulo">Administración</p>
    <ul class="panel-menu-lista">
      <li>
        <a href="/cuenta/administracion/usuarios" class="panel-menu-enlace{% if activa == 'usuarios' %} activo{% endif %}"{% if activa == 'usuarios' %} aria-current="page"{% endif %}>Usuarios y roles</a>
      </li>
      <li>
        <a href="/funcion/administracion/reservas" class="panel-menu-enlace{% if activa == 'reservas' %} activo{% endif %}"{% if activa == 'reservas' %} aria-current="page"{% endif %}>Reservas</a>
      </li>
      {# Todas las salas: qué pasó y qué conviene hacer (EF-09) #}
      <li>
        <a href="/recaudacion/reportes" class="panel-menu-enlace{% if activa == 'reportes' %} activo{% endif %}"{% if activa == 'reportes' %} aria-current="page"{% endif %}>Reportes</a>
      </li>
      {# Con cuánto se reparte lo cobrado entre la sala, el dueño y la plataforma (EF-08.1) #}
      <li>
        <a href="/recaudacion/administracion/reparto" class="panel-menu-enlace{% if activa == 'reparto' %} activo{% endif %}"{% if activa == 'reparto' %} aria-current="page"{% endif %}>Reparto</a>
      </li>
    </ul>
  </nav>
  {% endif %}

  <nav aria-label="Moderación">
    <p class="panel-menu-titulo">Moderación</p>
    <ul class="panel-menu-lista">
      <li>
        <a href="/moderacion/solicitudes" class="panel-menu-enlace{% if activa == 'solicitudes' %} activo{% endif %}"{% if activa == 'solicitudes' %} aria-current="page"{% endif %}>Solicitudes de sala</a>
      </li>
    </ul>
  </nav>

  {% if usuario %}
    <div class="panel-sesion">
      <div class="panel-sesion-usuario">
        <span class="usuario-avatar" aria-hidden="true">{{ usuario.nombre ? usuario.nombre|slice(0, 1)|upper : 'U' }}</span>
        <div class="panel-sesion-datos">
          <span class="panel-sesion-nombre">{{ usuario.nombre }}</span>
          <span class="usuario-rol rol-{{ usuario.rol.value }}">{{ usuario.rol.value }}</span>
        </div>
      </div>
      <form action="/cuenta/salir" method="POST">
        <input type="hidden" name="_csrf" value="{{ csrf }}">
        <button type="submit" class="boton boton-secundario boton-chico panel-salir">Cerrar sesión</button>
      </form>
    </div>
  {% endif %}
</aside>
