{#
  Barra lateral de «Mi cuenta» (E4-10.13), como los wireframes mi-cuenta-mis-datos y
  mi-cuenta-mis-reservas, con las secciones que ya tienen pantalla: «Mis datos», «Mis reservas» y,
  a quien alcanza el rol de organizador (también el moderador), su panel. El administrador no usa
  el sitio público, como en el encabezado: no ve el enlace al panel del organizador.

  Parámetros recibidos:
  - activa: (string) la sección actual: 'datos' o 'reservas'.
  - usuario: el usuario en sesión.
#}
{% set secciones = [
  { clave: 'datos', texto: 'Mis datos', url: '/cuenta/' },
  { clave: 'reservas', texto: 'Mis reservas', url: '/funcion/reservas' },
] %}
{% if usuario and usuario.alcanza('organizador') and not usuario.alcanza('administrador') %}
  {% set secciones = secciones|merge([{ clave: 'organizador', texto: 'Panel del organizador', url: '/organizador/salas' }]) %}
{% endif %}
<nav class="mi-cuenta-menu" aria-label="Mi cuenta">
  <ul class="mi-cuenta-menu-lista">
    {% for seccion in secciones %}
      <li>
        <a href="{{ seccion.url }}" class="mi-cuenta-menu-enlace{% if activa == seccion.clave %} activo{% endif %}"{% if activa == seccion.clave %} aria-current="page"{% endif %}>{{ seccion.texto }}</a>
      </li>
    {% endfor %}
  </ul>
</nav>
