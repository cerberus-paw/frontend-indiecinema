{#
  Parcial de mensaje de alerta reutilizable (IC-45).
  Renderiza alertas de éxito, error, advertencia e información con iconos accesibles,
  título opcional, texto descriptivo y lista detallada de errores si aplica.

  Parámetros recibidos:
  - tipo: (string, opcional, por defecto 'info') 'exito' | 'error' | 'advertencia' | 'info'.
  - mensaje: (string, opcional) Texto del mensaje principal a mostrar.
  - texto: (string, opcional) Alias de mensaje para compatibilidad con distintos controladores.
  - titulo: (string, opcional) Encabezado destacado dentro de la alerta.
  - detalles: (array, opcional) Lista de puntos o detalles adicionales (ej. lista de validaciones fallidas).
  - descartable: (bool, opcional, por defecto false) Si muestra botón de cierre.
  - clase: (string, opcional) Clases CSS adicionales para el contenedor.
#}
{# Define el tipo de alerta normalizado a partir de los valores recibidos o 'info' por defecto #}
{% set tipo_alerta = tipo ?? 'info' %}
{# Resuelve el contenido del mensaje admitiendo tanto la variable 'mensaje' como 'texto' para flexibilidad #}
{% set cuerpo_mensaje = mensaje ?? (texto ?? null) %}
{# Asocia el rol accesible 'alert' para errores o 'status' para otros mensajes informativos #}
{% set rol_accesible = (tipo_alerta == 'error' or tipo_alerta == 'advertencia') ? 'alert' : 'status' %}
{# Solo se renderiza el bloque de alerta si se proveyó un mensaje, título o lista de detalles #}
{% if cuerpo_mensaje or titulo is defined or detalles is defined %}
  {# Contenedor principal de la alerta con clases de tipo y modificadores opcionales #}
  <div class="alerta alerta-{{ tipo_alerta }}{% if clase is defined %} {{ clase }}{% endif %}" role="{{ rol_accesible }}">
    {# Envoltorio para el icono representativo del tipo de mensaje #}
    <div class="alerta-icono" aria-hidden="true">
      {# Icono de confirmación verde para mensajes de éxito #}
      {% if tipo_alerta == 'exito' %}
        {# Marca de verificación para operaciones completadas exitosamente #}
        <span class="icono-simbolo">✓</span>
      {# Icono de advertencia triangular para avisos y precauciones #}
      {% elseif tipo_alerta == 'advertencia' %}
        {# Símbolo de advertencia para llamados de atención #}
        <span class="icono-simbolo">⚠️</span>
      {# Icono de peligro o error para operaciones fallidas #}
      {% elseif tipo_alerta == 'error' %}
        {# Cruz o signo de exclamación para errores #}
        <span class="icono-simbolo">✕</span>
      {# Icono informativo predeterminado #}
      {% else %}
        {# Símbolo de información para mensajes neutrales #}
        <span class="icono-simbolo">ℹ</span>
      {# Cierre del condicional de selección de icono #}
      {% endif %}
    {# Cierre del envoltorio del icono #}
    </div>
    {# Contenedor del contenido textual de la alerta #}
    <div class="alerta-contenido">
      {# Si se especificó un título para la alerta, se renderiza con énfasis #}
      {% if titulo is defined %}
        {# Encabezado en negrita del mensaje #}
        <strong class="alerta-titulo">{{ titulo }}</strong>
      {# Cierre del condicional de título #}
      {% endif %}
      {# Si hay un cuerpo de mensaje principal, se muestra en un párrafo accesible #}
      {% if cuerpo_mensaje %}
        {# Párrafo con la descripción del mensaje #}
        <p class="alerta-texto">{{ cuerpo_mensaje }}</p>
      {# Cierre del condicional de cuerpo del mensaje #}
      {% endif %}
      {# Si se recibió una lista de detalles (ej. múltiples errores de validación) #}
      {% if detalles is defined and detalles is iterable and detalles|length > 0 %}
        {# Lista no ordenada con viñetas para cada detalle recibido #}
        <ul class="alerta-lista-detalles">
          {# Itera sobre cada detalle o ítem de la lista #}
          {% for detalle in detalles %}
            {# Elemento individual de la lista de detalles #}
            <li class="alerta-item-detalle">{{ detalle }}</li>
          {# Fin de la iteración de detalles #}
          {% endfor %}
        {# Cierre de la lista no ordenada #}
        </ul>
      {# Cierre del condicional de lista de detalles #}
      {% endif %}
    {# Cierre del contenedor de contenido #}
    </div>
    {# Si la alerta fue configurada como descartable por el usuario #}
    {% if descartable ?? false %}
      {# Botón interactivo para eliminar la alerta del DOM #}
      <button
        {# Declara el tipo button para evitar envíos involuntarios de formulario #}
        type="button"
        {# Clase con estilos para posicionamiento y hover #}
        class="alerta-cerrar"
        {# Etiqueta legible para tecnologías de asistencia #}
        aria-label="Cerrar notificación"
        {# Remueve la alerta contenedora al pulsar el botón #}
        onclick="this.closest('.alerta').remove();"
      {# Cierre de la etiqueta de apertura del botón #}
      >
        {# Carácter visual de cierre oculto a lectores de pantalla #}
        <span aria-hidden="true">&times;</span>
      {# Cierre del botón de descarte #}
      </button>
    {# Cierre del condicional de alerta descartable #}
    {% endif %}
  {# Cierre del contenedor principal de la alerta #}
  </div>
{# Cierre del condicional de renderizado de alerta #}
{% endif %}
