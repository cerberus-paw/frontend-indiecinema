{#
  Barra lateral de las pantallas del organizador, como el wireframe de la E2 (panel-organizador),
  armada con parciales/panel_menu.html.twig. Las secciones van agrupadas por lo que se maneja:
  las salas, las obras, las funciones, la plata y los espectadores. «Mis obras» y «Cargar obra»
  estaban fuera del panel, en el sitio público, y sólo se llegaba desde el menú de la cuenta
  (F-02.23): ahora son del panel, como el resto. «Recaudación» del wireframe son los reportes
  (EF-09) y las liquidaciones (EF-08.3). El logo lleva a la portada: el organizador también usa la
  cartelera y las salas. «Publicar una sala» pasa por la solicitud, como la primera: es una página
  del sitio, fuera del panel, así que nunca queda marcada.

  Parámetros recibidos:
  - activa: (string) la sección actual: 'salas', 'obras', 'obra_nueva', 'funciones', 'programar',
    'pedidos', 'reportes', 'liquidaciones' o 'bloqueados'.
  - usuario: el usuario en sesión.
  - csrf: el token del formulario para salir.
#}
{% include 'parciales/panel_menu.html.twig' with {
  rol: 'organizador',
  nombre: 'Panel del organizador',
  icono: 'butaca',
  inicio: '/',
  sitio: true,
  grupos: [
    { titulo: 'Salas', secciones: [
      { clave: 'salas', texto: 'Mis salas', url: '/organizador/salas', icono: 'butaca' },
      { clave: null, texto: 'Publicar una sala', url: '/solicitar-sala', icono: 'mas' },
    ] },
    { titulo: 'Obras', secciones: [
      { clave: 'obras', texto: 'Mis obras', url: '/organizador/obras', icono: 'pelicula' },
      { clave: 'obra_nueva', texto: 'Cargar obra', url: '/organizador/obras/nueva', icono: 'mas' },
    ] },
    { titulo: 'Funciones', secciones: [
      { clave: 'funciones', texto: 'Mis funciones', url: '/organizador/funciones', icono: 'calendario' },
      { clave: 'programar', texto: 'Programar función', url: '/organizador/funciones/nueva', icono: 'mas' },
      { clave: 'pedidos', texto: 'Pedidos para programar', url: '/organizador/pedidos', icono: 'sobre' },
    ] },
    { titulo: 'Recaudación', secciones: [
      { clave: 'reportes', texto: 'Reportes', url: '/recaudacion/reportes', icono: 'grafico' },
      { clave: 'liquidaciones', texto: 'Mis liquidaciones', url: '/recaudacion/liquidaciones', icono: 'moneda' },
    ] },
    { titulo: 'Espectadores', secciones: [
      { clave: 'bloqueados', texto: 'Usuarios bloqueados', url: '/organizador/bloqueados', icono: 'prohibido' },
    ] },
  ],
  activa: activa,
  usuario: usuario,
  csrf: csrf,
} only %}
