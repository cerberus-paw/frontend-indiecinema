{#
  Ícono de línea, como los del wireframe (el pin de la sala, el reloj de la franja, el aviso).
  Va en SVG dentro de la página: no pide archivos y toma el color del texto (currentColor).
  Es decorativo: siempre acompaña un texto que dice lo mismo, así que los lectores de pantalla
  lo saltean (aria-hidden).

  Reemplaza a los emojis, que cada sistema dibuja distinto y no siguen la línea del sitio.

  Variables:
  - nombre: (string) 'ubicacion' | 'calendario' | 'reloj' | 'check' | 'advertencia' | 'entrada' |
    'claqueta' | 'pelicula' | 'butaca' | 'documento' | 'lupa' | 'personas' | 'persona' | 'mas' |
    'grafico' | 'sobre' | 'bandera' | 'salir' | 'moneda' | 'porcentaje' | 'tienda' | 'prohibido' |
    'escudo' | 'engranaje' | 'casa' | 'candado'.
  - clase: (string, opcional) clase extra para ubicarlo.
#}
<svg class="icono icono-{{ nombre }}{% if clase is defined %} {{ clase }}{% endif %}" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- if nombre == 'ubicacion' -%}
    <path d="M12 21s-6.5-5.8-6.5-11a6.5 6.5 0 0 1 13 0c0 5.2-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.25"/>
  {%- elseif nombre == 'calendario' -%}
    <rect x="3.5" y="5" width="17" height="15.5" rx="2"/><path d="M3.5 10h17M8 3v4M16 3v4"/>
  {%- elseif nombre == 'reloj' -%}
    <circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>
  {%- elseif nombre == 'check' -%}
    <path d="M5 12.5l4.5 4.5L19 7.5"/>
  {%- elseif nombre == 'advertencia' -%}
    <path d="M12 4L2.75 19.5h18.5L12 4z"/><path d="M12 10v4.25"/><path d="M12 17.25h.01"/>
  {%- elseif nombre == 'entrada' -%}
    {# Una entrada de cine con el troquel: la de los lugares libres #}
    <path d="M3.5 8a1.5 1.5 0 0 1 1.5-1.5h14A1.5 1.5 0 0 1 20.5 8v2a2 2 0 0 0 0 4v2a1.5 1.5 0 0 1-1.5 1.5H5A1.5 1.5 0 0 1 3.5 16v-2a2 2 0 0 0 0-4z"/><path d="M14.5 7v1.5M14.5 11.25v1.5M14.5 15.5V17"/>
  {%- elseif nombre == 'claqueta' -%}
    {# La claqueta: quien dirigió la película #}
    <path d="M4 10h16v9a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 19z"/><path d="M4 10l-.6-3.2a1.5 1.5 0 0 1 1.2-1.75l12.8-2.3a1.5 1.5 0 0 1 1.75 1.2L19.6 7"/><path d="M8.5 4.4l2 4.6M13.5 3.5l2 4.6"/>
  {%- elseif nombre == 'pelicula' -%}
    {# Un cuadro de película con sus perforaciones: el lugar del afiche y lo que es una obra #}
    <rect x="3.5" y="4" width="17" height="16" rx="2"/><path d="M7.5 4v16M16.5 4v16M3.5 8h4M3.5 12h4M3.5 16h4M16.5 8h4M16.5 12h4M16.5 16h4"/>
  {%- elseif nombre == 'butaca' -%}
    {# Una butaca: la capacidad de la sala #}
    <path d="M6.5 11V6.5A2.5 2.5 0 0 1 9 4h6a2.5 2.5 0 0 1 2.5 2.5V11"/><path d="M4.5 11h15v5.5h-15z"/><path d="M6 16.5V20M18 16.5V20"/>
  {%- elseif nombre == 'documento' -%}
    {# Un papel con el borde doblado: el derecho de la copia #}
    <path d="M14 3.5H7A1.5 1.5 0 0 0 5.5 5v14A1.5 1.5 0 0 0 7 20.5h10a1.5 1.5 0 0 0 1.5-1.5V8z"/><path d="M14 3.5V8h4.5M9 12.5h6M9 16h6"/>
  {%- elseif nombre == 'lupa' -%}
    <circle cx="10.5" cy="10.5" r="6"/><path d="M15 15l5 5"/>
  {%- elseif nombre == 'personas' -%}
    <circle cx="9" cy="8.5" r="3"/><path d="M3.5 19.5a5.5 5.5 0 0 1 11 0"/><path d="M15.5 6a3 3 0 0 1 0 5.5M17 14.5a5.5 5.5 0 0 1 3.5 5"/>
  {%- elseif nombre == 'persona' -%}
    <circle cx="12" cy="8.5" r="3.5"/><path d="M5 20a7 7 0 0 1 14 0"/>
  {%- elseif nombre == 'mas' -%}
    <path d="M12 5v14M5 12h14"/>
  {%- elseif nombre == 'grafico' -%}
    <path d="M4 20h16"/><path d="M7 20v-6M12 20V8M17 20v-9"/>
  {%- elseif nombre == 'sobre' -%}
    <rect x="3.5" y="5.5" width="17" height="13" rx="1.5"/><path d="M4 7l8 6 8-6"/>
  {%- elseif nombre == 'bandera' -%}
    <path d="M5.5 21V4.5"/><path d="M5.5 4.5h11l-2 4 2 4h-11"/>
  {%- elseif nombre == 'salir' -%}
    <path d="M14 4.5H6.5A1.5 1.5 0 0 0 5 6v12a1.5 1.5 0 0 0 1.5 1.5H14"/><path d="M10 12h10M16.5 8.5L20 12l-3.5 3.5"/>
  {%- elseif nombre == 'moneda' -%}
    {# Una moneda con el signo: lo que se liquida #}
    <circle cx="12" cy="12" r="8.5"/><path d="M14.75 9.25c-.5-1-1.5-1.5-2.75-1.5-1.5 0-2.75.75-2.75 2s1.25 1.75 2.75 2.25 2.75 1 2.75 2.25-1.25 2-2.75 2c-1.25 0-2.25-.5-2.75-1.5M12 6v1.75M12 16.25V18"/>
  {%- elseif nombre == 'porcentaje' -%}
    {# El reparto: qué parte de lo cobrado va a cada uno #}
    <path d="M18.5 5.5l-13 13"/><circle cx="7.5" cy="7.5" r="2.25"/><circle cx="16.5" cy="16.5" r="2.25"/>
  {%- elseif nombre == 'tienda' -%}
    {# Un local con su toldo: los comercios asociados #}
    <path d="M4 9.5l1.5-5h13l1.5 5"/><path d="M4 9.5a2.65 2.65 0 0 0 5.33 0 2.65 2.65 0 0 0 5.34 0 2.65 2.65 0 0 0 5.33 0"/><path d="M5.5 12v8h13v-8M10 20v-4.5h4V20"/>
  {%- elseif nombre == 'prohibido' -%}
    {# Un círculo tachado: quien no puede reservar en la sala #}
    <circle cx="12" cy="12" r="8.5"/><path d="M6 6l12 12"/>
  {%- elseif nombre == 'escudo' -%}
    {# Un escudo: la moderación #}
    <path d="M12 3.5l7 2.75v5c0 4.5-3 7.75-7 9.25-4-1.5-7-4.75-7-9.25v-5z"/><path d="M9 12l2 2 4-4"/>
  {%- elseif nombre == 'engranaje' -%}
    {# Un engranaje: la administración de la plataforma #}
    <circle cx="12" cy="12" r="3"/><path d="M12 3.5v2.25M12 18.25v2.25M3.5 12h2.25M18.25 12h2.25M6 6l1.6 1.6M16.4 16.4L18 18M6 18l1.6-1.6M16.4 7.6L18 6"/><circle cx="12" cy="12" r="6.25"/>
  {%- elseif nombre == 'casa' -%}
    {# Una casa: volver al sitio público #}
    <path d="M4 11l8-6.5 8 6.5"/><path d="M6 9.5v10h12v-10"/><path d="M10 19.5v-5h4v5"/>
  {%- elseif nombre == 'candado' -%}
    {# Un candado: la contraseña #}
    <rect x="5" y="10.5" width="14" height="10" rx="1.5"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/><path d="M12 14.5v2.5"/>
  {%- endif -%}
</svg>
