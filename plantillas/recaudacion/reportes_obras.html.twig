{#
  El reporte del dueño de obras, en /recaudacion/reportes/obras (EF-09.3): cómo le fue a cada obra
  suya en las funciones finalizadas del período, en cualquier sala. Con el armado de los otros
  reportes; cada obra lleva a su detalle (reportes_obra.html.twig). Lo que le corresponde sale con
  el reparto.

  Variables:
  - periodo: desde, hasta (AAAA-MM-DD) y texto (null si el elegido no sirve).
  - administrador: (bool) va con la barra del administrador.
  - error: (string, opcional) por qué no se pudo usar el período; entonces no hay datos.
  - avisos: lista de textos: lo que faltó porque un subsistema no respondió.
  - resumen: {obras, funciones, asistentes, asistencia, promedio, …} de las funciones en las que se
    proyectó alguna, contadas una vez.
  - obras: lista de {titulo, url, funciones, asistentes, asistencia, promedio, votaciones, ganadas,
    votos}, por título. Lo que no se pudo calcular viene en null.
#}
{% extends administrador ? 'administracion.html.twig' : 'organizador.html.twig' %}

{% block titulo %}Reportes · Mis obras{% endblock %}

{% block seccion %}reportes{% endblock %}

{% block panel %}
<header class="panel-cabecera">
  <h1 class="panel-titulo">Reportes</h1>
  <p class="panel-bajada">Cómo le fue a cada obra tuya{% if periodo.texto %} {{ periodo.texto }}{% endif %}, en cualquier sala: dónde se proyectó, cuánta gente fue y cómo la votaron.</p>
</header>

{% include 'parciales/pestanas_reportes.html.twig' with { activa: 'obras', periodo: periodo, administrador: administrador } only %}

<form class="panel-filtros reporte-filtros" action="/recaudacion/reportes/obras" method="get" aria-label="Elegir el período">
  <label class="reporte-filtro">
    <span class="reporte-filtro-etiqueta">Desde</span>
    <input type="date" name="desde" value="{{ periodo.desde }}" class="campo-control" required>
  </label>
  <label class="reporte-filtro">
    <span class="reporte-filtro-etiqueta">Hasta</span>
    <input type="date" name="hasta" value="{{ periodo.hasta }}" class="campo-control" required>
  </label>
  {% include 'parciales/boton.html.twig' with { texto: 'Ver el período', tipo: 'submit', variante: 'primario' } only %}
</form>

{% include 'parciales/resumen_de_errores.html.twig' with {
  error_general: error ?? null,
  titulo: 'No se pudo mostrar el período'
} only %}

{% if error is not defined or error is null %}
  {% for aviso in avisos %}
    {% include 'parciales/mensaje.html.twig' with { tipo: 'advertencia', mensaje: aviso } only %}
  {% endfor %}

  {% if obras is empty %}
    {% if avisos is empty %}
      {% include 'parciales/mensaje.html.twig' with { tipo: 'info', mensaje: 'Ninguna obra tuya estuvo en una función finalizada en el período. Probá con uno más largo.' } only %}
    {% endif %}
  {% else %}
    <dl class="panel-resumen">
      <div class="panel-dato">
        <dt>Obras</dt>
        <dd class="panel-dato-valor">{{ resumen.obras }}</dd>
        <dd class="panel-dato-nota">en funciones del período</dd>
      </div>
      <div class="panel-dato">
        <dt>Funciones</dt>
        <dd class="panel-dato-valor">{{ resumen.funciones }}</dd>
        <dd class="panel-dato-nota">en las que se proyectaron</dd>
      </div>
      <div class="panel-dato">
        <dt>Público</dt>
        <dd class="panel-dato-valor">{{ resumen.asistentes ?? '—' }}</dd>
        <dd class="panel-dato-nota">personas fueron a verlas</dd>
      </div>
      <div class="panel-dato">
        <dt>Calificación</dt>
        <dd class="panel-dato-valor">{{ resumen.promedio ?? '—' }}</dd>
        <dd class="panel-dato-nota">{{ resumen.promedio ? 'promedio, de 1 a 5' : 'nadie calificó todavía' }}</dd>
      </div>
    </dl>

    <section class="reporte-seccion" aria-labelledby="reporte-obras">
      <h2 id="reporte-obras" class="reporte-subtitulo">Tus obras</h2>
      <p class="reporte-explicacion">«Votaciones» cuenta las funciones en las que el público eligió entre varias obras: las que ganó y en cuántas estuvo. Elegí una para ver dónde y cuándo se proyectó. Lo que te corresponde sale con el reparto.</p>
      <div class="tabla-admin-contenedor" tabindex="0" role="region" aria-labelledby="reporte-obras">
        <table class="tabla-admin reporte-tabla">
          <thead>
            <tr>
              <th scope="col">Obra</th>
              <th scope="col">Funciones</th>
              <th scope="col">Público</th>
              <th scope="col">Promedio</th>
              <th scope="col">Votaciones</th>
              <th scope="col">Votos</th>
            </tr>
          </thead>
          <tbody>
            {% for obra in obras %}
              <tr>
                <td><a href="{{ obra.url }}" class="tabla-admin-principal">{{ obra.titulo }}</a></td>
                <td>{{ obra.funciones }}</td>
                <td>{{ obra.asistentes ?? '—' }}{% if obra.asistencia %} <span class="tabla-admin-secundario">{{ obra.asistencia }} de los que reservaron</span>{% endif %}</td>
                <td>{{ obra.promedio ?? '—' }}</td>
                <td>{% if obra.votaciones > 0 %}ganó {{ obra.ganadas }} de {{ obra.votaciones }}{% else %}—{% endif %}</td>
                <td>{{ obra.votaciones > 0 ? obra.votos : '—' }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </section>
  {% endif %}
{% endif %}
{% endblock %}
