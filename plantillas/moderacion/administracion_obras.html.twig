{#
  La pestaña «Obras» de la bandeja de moderación, en /moderacion/obras (EF-07.7): las obras que
  cargan los organizadores quedan pendientes hasta que un moderador las aprueba o las rechaza con
  un motivo, que le llega a su dueño. La lista a la izquierda, primero la que lleva más tiempo, y
  la elegida a la derecha, con sus datos, el afiche y quién la cargó. «Ver historial» lista las
  resueltas. Por ?id= se abre también una que no está pendiente: una aprobada se rechaza (la
  denuncia de EF-07.8).

  Variables:
  - historial: si la vista es la del historial.
  - sin_programacion: si programación no respondió y no hay lista.
  - obras: lista de {id, titulo, tipo, anio, cargada, elegida}.
  - resueltas: en el historial, lista de {titulo, resolucion (aprobada o rechazada), motivo, resuelta}.
  - elegida: {id, titulo, tipo, anio, director, duracion, sinopsis, generos, origen_copia, afiche
    (o null), cargada, dueno ({nombre, correo}, null si ya no existe o false si cuentas no
    respondió), propia, estado (pendiente, aprobada o rechazada), resoluciones (las que admite:
    aprobar y rechazar; una aprobada, sólo rechazar; una rechazada, ninguna)}, o null. propia: la
    cargó el moderador en sesión, que no la resuelve.
  - valores: lo que mandó si hubo errores, {resolucion, motivo}.
  - errores: campo => qué está mal.
  - maximo_motivo: el largo máximo del motivo, el mismo que controla el backend.
  - mensaje_exito: el aviso de lo que se acaba de hacer (opcional).
#}
{% extends 'administracion.html.twig' %}

{% block titulo %}Obras para revisar{% endblock %}

{% block seccion %}obras{% endblock %}

{% block panel %}
<header class="panel-cabecera bandeja-cabecera">
  <div>
    <h1 class="panel-titulo">Obras para revisar</h1>
    <p class="panel-bajada">Las obras nuevas entran al catálogo cuando las aprobás. Resolvé con un motivo: le llega a su dueño.</p>
  </div>
  {% if historial %}
    <a href="{{ prefijo }}/obras" class="boton boton-secundario">Volver a las pendientes</a>
  {% else %}
    <a href="{{ prefijo }}/obras?ver=historial" class="boton boton-secundario">Ver historial</a>
  {% endif %}
</header>

{% if mensaje_exito is defined %}
  {% include 'parciales/mensaje.html.twig' with { tipo: 'exito', mensaje: mensaje_exito } only %}
{% endif %}

{% if historial %}
  {% if resueltas is empty %}
    <p class="bandeja-nota bandeja-nota-suelta">Todavía no se resolvió ninguna obra.</p>
  {% else %}
    <ul class="bandeja-items">
      {% for revision in resueltas %}
        <li class="bandeja-item">
          <span class="bandeja-item-fila">
            <span class="bandeja-item-sala">{{ revision.titulo }}</span>
            <span class="estado-cuenta {{ revision.resolucion == 'aprobada' ? 'estado-cuenta-activa' : 'estado-cuenta-suspendida' }}">{{ revision.resolucion == 'aprobada' ? 'Aprobada' : 'Rechazada' }}</span>
          </span>
          <span class="bandeja-item-datos">{{ revision.resuelta }}</span>
          <span class="bandeja-item-datos">{{ revision.motivo }}</span>
        </li>
      {% endfor %}
    </ul>
  {% endif %}
{% elseif sin_programacion %}
  <p class="bandeja-nota bandeja-nota-suelta">No pudimos consultar las obras pendientes. Probá de nuevo en un rato.</p>
{% elseif obras is empty and not elegida %}
  <p class="bandeja-nota bandeja-nota-suelta">No hay obras esperando revisión.</p>
{% else %}
  <div class="bandeja">
    <section class="bandeja-lista" aria-label="Obras pendientes">
      {% if obras is empty %}
        <p class="bandeja-nota">No hay obras esperando revisión.</p>
      {% endif %}
      <ul class="bandeja-items">
        {% for obra in obras %}
          <li>
            <a href="{{ prefijo }}/obras?id={{ obra.id }}" class="bandeja-item{% if obra.elegida %} activo{% endif %}"{% if obra.elegida %} aria-current="true"{% endif %}>
              <span class="bandeja-item-fila">
                <span class="bandeja-item-sala">{{ obra.titulo }}</span>
                <span class="estado-cuenta">Pendiente</span>
              </span>
              <span class="bandeja-item-datos">{{ obra.tipo }} · {{ obra.anio }}</span>
              {% if obra.cargada %}<span class="bandeja-item-datos"><span aria-hidden="true">📅</span> Cargada {{ obra.cargada }}</span>{% endif %}
            </a>
          </li>
        {% endfor %}
      </ul>
    </section>

    {% if elegida %}
      {% set resolvible = not elegida.propia and elegida.resoluciones is not empty %}
      {% set estados = { pendiente: ['', 'Pendiente'], aprobada: [' estado-cuenta-activa', 'Aprobada'], rechazada: [' estado-cuenta-suspendida', 'Rechazada'] } %}
      <article class="bandeja-detalle" aria-labelledby="titulo-obra">
        <header class="bandeja-detalle-cabecera">
          <h2 id="titulo-obra" class="bandeja-detalle-titulo">{{ elegida.titulo }}</h2>
          <span class="estado-cuenta{{ estados[elegida.estado][0] }}">{{ estados[elegida.estado][1] }}</span>
        </header>
        <p class="bandeja-detalle-datos bandeja-detalle-meta">
          <span>{{ elegida.tipo }} · {{ elegida.anio }}</span>
          <span>{{ elegida.duracion }} minutos</span>
          {% if elegida.cargada %}<span>Cargada el {{ elegida.cargada }}</span>{% endif %}
        </p>

        {% if resolvible %}
          {% include 'parciales/resumen_de_errores.html.twig' with { errores: errores } only %}
          <form action="{{ prefijo }}/obras/{{ elegida.id }}/resolver" method="post">
          <input type="hidden" name="_csrf" value="{{ csrf }}">
        {% endif %}
        <div class="bandeja-columnas">
          <div>
            {% if elegida.afiche %}
              <img src="{{ elegida.afiche }}" alt="Afiche de {{ elegida.titulo }}" class="bandeja-foto">
            {% endif %}
            <h3 class="bandeja-subtitulo">Sinopsis</h3>
            <p class="bandeja-texto">{{ elegida.sinopsis|nl2br }}</p>
            <dl class="bandeja-ficha">
              <dt>Dirección</dt>
              <dd>{{ elegida.director }}</dd>
              {# Los géneros son opcionales al cargar la obra: sin ninguno, la fila no va. #}
              {% if elegida.generos is not empty %}
                <dt>Géneros</dt>
                <dd>{{ elegida.generos|join(', ') }}</dd>
              {% endif %}
              <dt>Derecho de la copia</dt>
              <dd>{{ elegida.origen_copia }}</dd>
            </dl>
            <h3 class="bandeja-subtitulo">Quién la cargó</h3>
            {% if elegida.dueno is same as(false) %}
              <p class="bandeja-nota bandeja-nota-suelta">No pudimos consultar los datos de la cuenta. Probá de nuevo en un rato.</p>
            {% elseif elegida.dueno is null %}
              <p class="bandeja-nota bandeja-nota-suelta">La cuenta que la cargó ya no existe.</p>
            {% else %}
              <p class="bandeja-texto">{{ elegida.dueno.nombre }} · <a href="mailto:{{ elegida.dueno.correo|url_encode|replace({'%40': '@'}) }}">{{ elegida.dueno.correo }}</a></p>
            {% endif %}
          </div>

          <div>
            {% if elegida.propia %}
              <div class="bandeja-caja">
                <p class="bandeja-caja-titulo">Resolución</p>
                <p class="bandeja-texto">La cargaste vos: la resuelve otro moderador.</p>
              </div>
            {% elseif not resolvible %}
              <div class="bandeja-caja">
                <p class="bandeja-caja-titulo">Resolución</p>
                <p class="bandeja-texto">Está rechazada: vuelve a revisión cuando su dueño la corrige.</p>
              </div>
            {% else %}
              <fieldset id="resolucion" class="bandeja-caja{% if errores.resolucion is defined %} con-error{% endif %}">
                <legend class="bandeja-caja-titulo">Resolución</legend>
                {% for valor, texto in { aprobar: 'Aprobarla: entra en el catálogo', rechazar: elegida.estado == 'aprobada' ? 'Rechazarla: sale del catálogo y de las votaciones abiertas' : 'Rechazarla' }|filter((texto, valor) => valor in elegida.resoluciones) %}
                  <label class="bandeja-opcion">
                    <input type="radio" name="resolucion" value="{{ valor }}" required{% if (valores.resolucion ?? '') == valor %} checked{% endif %}{% if errores.resolucion is defined %} aria-invalid="true" aria-describedby="error-resolucion"{% endif %}>
                    {{ texto }}
                  </label>
                {% endfor %}
                {% if errores.resolucion is defined %}
                  <span id="error-resolucion" class="campo-error" role="alert"><span class="error-icono" aria-hidden="true">⚠️</span> {{ errores.resolucion }}</span>
                {% endif %}
              </fieldset>
            {% endif %}
          </div>
        </div>

        {% if resolvible %}
          <div class="bandeja-motivo">
            {% include 'parciales/campo.html.twig' with {
              nombre: 'motivo',
              etiqueta: 'Motivo de la resolución',
              tipo: 'textarea',
              filas: 4,
              valor: valores.motivo ?? '',
              requerido: true,
              maximo: maximo_motivo,
              ayuda: 'Obligatorio. Le llega a su dueño.',
              errores: errores
            } only %}
            <div class="bandeja-acciones">
              <button type="submit" class="boton boton-primario">Enviar resolución</button>
            </div>
          </div>
          </form>
        {% endif %}
      </article>
    {% endif %}
  </div>
{% endif %}
{% endblock %}
